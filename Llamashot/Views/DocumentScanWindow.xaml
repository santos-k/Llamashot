<Window x:Class="Llamashot.Views.DocumentScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="Document Scan"
        Width="1100" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowGradientBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Cap">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Button" x:Key="Tool">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Accent" BasedOn="{StaticResource Tool}">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconFill" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="IconStroke" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <PathGeometry x:Key="IcOpen" Figures="M1.5,4.5 L6,4.5 L7.5,6 L14.5,6 L14.5,13 L1.5,13 Z" />
        <PathGeometry x:Key="IcAuto" Figures="M8,1 L9.2,6.8 L15,8 L9.2,9.2 L8,15 L6.8,9.2 L1,8 L6.8,6.8 Z" />
        <PathGeometry x:Key="IcCrop" Figures="M4,1 L4,12 L15,12 M1,4 L12,4 L12,15" />
        <PathGeometry x:Key="IcEdit" Figures="M2,14 L2,11 L10.5,2.5 L13.5,5.5 L5,14 Z M9.5,3.5 L12.5,6.5" />
        <PathGeometry x:Key="IcReset" Figures="M12.6,6.2 A5,5 0 1 0 13,10.4 M12.6,6.2 L9.9,5.7 M12.6,6.2 L12.1,8.9" />
        <PathGeometry x:Key="IcRotL" Figures="M5.5,3 L2.5,6 L5.5,9 M2.5,6 L10,6 A4,4 0 0 1 10,14 L6,14" />
        <PathGeometry x:Key="IcRotR" Figures="M10.5,3 L13.5,6 L10.5,9 M13.5,6 L6,6 A4,4 0 0 0 6,14 L10,14" />
        <PathGeometry x:Key="IcDown" Figures="M8,2 L8,10 M4.5,6.8 L8,10.5 L11.5,6.8 M3,14 L13,14" />
        <PathGeometry x:Key="IcPdf" Figures="M3,1.5 L10,1.5 L13,4.5 L13,14.5 L3,14.5 Z M10,1.5 L10,4.5 L13,4.5" />
        <PathGeometry x:Key="IcFlipH" Figures="M8,2 L8,14 M5.5,5 L2,8 L5.5,11 M10.5,5 L14,8 L10.5,11" />
        <PathGeometry x:Key="IcFlipV" Figures="M2,8 L14,8 M5,5.5 L8,2 L11,5.5 M5,10.5 L8,14 L11,10.5" />
        <PathGeometry x:Key="IcClose" Figures="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5" />
        <PathGeometry x:Key="IcCheck" Figures="M2.5,8.5 L6.5,12.5 L13.5,3.5" />

        <!-- Corner-handle thumb: a draggable accent ring -->
        <Style x:Key="Corner" TargetType="Thumb">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Fill="#33000000" />
                            <Ellipse Margin="3" Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource HeaderGradientBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Document Scan" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />

                <Button x:Name="BtnOpen" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="Open_Click" ToolTip="Open a document photo  (O)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" /><TextBlock Text="Open" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource Tool}" Margin="0,16,12,0" Click="CloseFile_Click" ToolTip="Close the current file  (Esc)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcClose}" /><TextBlock Text="Close" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnAuto" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="AutoDetect_Click"
                        ToolTip="Auto-detect the document edges  (D)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcAuto}" /><TextBlock Text="Detect Edges" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnReset" Style="{StaticResource Tool}" Margin="0,16,12,0" Click="Reset_Click" ToolTip="Reset corners to the full image  (R)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcReset}" /><TextBlock Text="Reset" VerticalAlignment="Center" /></StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,18,12,0" Height="30" />

                <Button x:Name="BtnRotL" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="RotateLeft_Click" ToolTip="Rotate left 90°">
                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource IcRotL}" Margin="0" />
                </Button>
                <Button x:Name="BtnRotR" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="RotateRight_Click" ToolTip="Rotate right 90°">
                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource IcRotR}" Margin="0" />
                </Button>
                <Button x:Name="BtnFlipH" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="FlipH_Click" ToolTip="Flip horizontal">
                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource IcFlipH}" Margin="0" />
                </Button>
                <Button x:Name="BtnFlipV" Style="{StaticResource Tool}" Margin="0,16,12,0" Click="FlipV_Click" ToolTip="Flip vertical">
                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource IcFlipV}" Margin="0" />
                </Button>

                <Border Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,18,12,0" Height="30" />

                <Button x:Name="BtnCrop" Style="{StaticResource Accent}" Margin="0,16,8,0" Click="Crop_Click"
                        ToolTip="Warp the selected quad into a flat rectangle  (Enter)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcCrop}" /><TextBlock Text="Crop to Rectangle" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnEdit" Style="{StaticResource Tool}" Margin="0,16,12,0" Click="EditCorners_Click"
                        Visibility="Collapsed" ToolTip="Go back and adjust the corners">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcEdit}" /><TextBlock Text="Adjust Corners" VerticalAlignment="Center" /></StackPanel>
                </Button>

                <!-- Filters -->
                <StackPanel x:Name="FilterBar" Orientation="Horizontal" Margin="0,16,12,0">
                    <Button x:Name="BtnFNone" Style="{StaticResource Tool}" Margin="0,0,6,0" Click="Filter_Click" Tag="Original" Content="None" ToolTip="No filter — original colours" />
                    <Button x:Name="BtnFMagic" Style="{StaticResource Tool}" Margin="0,0,6,0" Click="Filter_Click" Tag="Magic" Content="Magic Colour" ToolTip="Brighten paper, deepen ink" />
                    <Button x:Name="BtnFGray" Style="{StaticResource Tool}" Margin="0,0,6,0" Click="Filter_Click" Tag="Grayscale" Content="Grayscale" />
                    <Button x:Name="BtnFBw" Style="{StaticResource Tool}" Margin="0,0,0,0" Click="Filter_Click" Tag="BlackWhite" Content="B &amp; W" ToolTip="Clean black text on white — best for documents" />
                </StackPanel>

                <Border Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,18,12,0" Height="30" />

                <Button x:Name="BtnSavePng" Style="{StaticResource Accent}" Margin="0,16,6,0" Click="SavePng_Click" ToolTip="Save as PNG  (Ctrl+S)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcDown}" /><TextBlock Text="PNG" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnSaveJpg" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="SaveJpg_Click" ToolTip="Save as JPG">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcDown}" /><TextBlock Text="JPG" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnSavePdf" Style="{StaticResource Tool}" Margin="0,16,0,0" Click="SavePdf_Click" ToolTip="Save as PDF  (Ctrl+P)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcPdf}" /><TextBlock Text="PDF" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnApply" Style="{StaticResource Accent}" Margin="0,16,0,0" Click="Apply_Click" Visibility="Collapsed"
                        ToolTip="Use this flattened scan in the PDF  (Enter)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcCheck}" /><TextBlock Text="Use in PDF" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Canvas -->
        <Grid Grid.Row="1">
            <Border x:Name="CenterHost" ClipToBounds="True" SizeChanged="CenterHost_SizeChanged" Background="#11000000">
                <Canvas x:Name="PanCanvas" Background="Transparent">
                    <!-- Adjust stage: source image + quad overlay -->
                    <Image x:Name="Img" Stretch="Fill" />
                    <!-- Result stage: warped rectangle -->
                    <Image x:Name="ResultImg" Stretch="Fill" Visibility="Collapsed" />

                    <Canvas x:Name="Overlay">
                        <Polygon x:Name="Quad" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                 Fill="#22000000" StrokeDashArray="0" />
                        <Thumb x:Name="ThTL" Style="{StaticResource Corner}" DragDelta="Corner_Drag"
                               DragStarted="Corner_Start" DragCompleted="Corner_Done" Tag="0" />
                        <Thumb x:Name="ThTR" Style="{StaticResource Corner}" DragDelta="Corner_Drag"
                               DragStarted="Corner_Start" DragCompleted="Corner_Done" Tag="1" />
                        <Thumb x:Name="ThBR" Style="{StaticResource Corner}" DragDelta="Corner_Drag"
                               DragStarted="Corner_Start" DragCompleted="Corner_Done" Tag="2" />
                        <Thumb x:Name="ThBL" Style="{StaticResource Corner}" DragDelta="Corner_Drag"
                               DragStarted="Corner_Start" DragCompleted="Corner_Done" Tag="3" />
                    </Canvas>

                    <!-- Magnifier loupe (shown while dragging a corner) -->
                    <Border x:Name="Loupe" Width="150" Height="150" CornerRadius="75" Visibility="Collapsed"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="LoupeImg" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                                  Data="M75,60 L75,90 M60,75 L90,75" />
                        </Grid>
                    </Border>
                </Canvas>
            </Border>

            <TextBlock x:Name="TxtHint" Text="Drag the four corners onto the document, then Crop to Rectangle"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" IsHitTestVisible="False" />

            <!-- Initial empty state: a big centered Open button -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" Stretch="Uniform" Width="56" Height="56"
                      Fill="{DynamicResource TextMutedBrush}" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock Text="Open a document photo to start scanning"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <Button Style="{StaticResource Accent}" Click="Open_Click" HorizontalAlignment="Center" Padding="22,11" FontSize="14">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" /><TextBlock Text="Open Image" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </StackPanel>

            <!-- Zoom controls -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Tool}" Content="Fit" Click="Fit_Click" Margin="0,0,4,0" Padding="10,5" />
                    <TextBlock x:Name="TxtSize" Text="" VerticalAlignment="Center" Margin="6,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                </StackPanel>
            </Border>

            <Border x:Name="BusyOverlay" Background="#99000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                    <TextBlock x:Name="TxtBusy" Text="Working…" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <ProgressBar x:Name="PrgBusy" Height="6" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
