<Window x:Class="Llamashot.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Required"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ControlTemplate x:Key="DialogButton" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#3A4A8A"/>
        </Border.Effect>
        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="18" Background="#336E8BFF"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#x1F512;" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtTitle" Text="Password Required" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtMessage" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       LineHeight="20" Margin="0,0,0,12"
                       Text="This PDF is password-protected. Enter its password to open it."/>
            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,2">
                <PasswordBox x:Name="PwBox" FontSize="14" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}" Height="30"
                             VerticalContentAlignment="Center"
                             KeyDown="PwBox_KeyDown"/>
            </Border>
            <TextBlock x:Name="TxtError" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                       Margin="2,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Padding="16,9"
                        FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Cursor="Hand" BorderThickness="0" Template="{StaticResource DialogButton}"
                        IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnOk" Content="Unlock" MinWidth="100" Padding="16,9"
                        FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                        Background="{DynamicResource AccentBrush}"
                        Cursor="Hand" BorderThickness="0" Template="{StaticResource DialogButton}"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
