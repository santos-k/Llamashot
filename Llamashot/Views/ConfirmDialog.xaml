<Window x:Class="Llamashot.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Llamashot"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ControlTemplate x:Key="DialogButton" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#3A4A8A"/>
        </Border.Effect>
        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border x:Name="IconCircle" Width="36" Height="36" CornerRadius="18" Background="#33FFA726"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="&#x26A0;" FontSize="18" Foreground="#FFA726"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtTitle" Text="Unsaved Changes" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtMessage" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       LineHeight="20" Margin="0,0,0,20"
                       Text="You have unsaved changes. If you leave now, your work will be lost."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Stay" MinWidth="90" Padding="16,9"
                        FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Cursor="Hand" BorderThickness="0" Template="{StaticResource DialogButton}"
                        IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnConfirm" Content="Leave Anyway" MinWidth="110" Padding="16,9"
                        FontSize="13" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource DangerBrush}"
                        Cursor="Hand" BorderThickness="0" Template="{StaticResource DialogButton}"
                        IsDefault="True" Click="Confirm_Click"/>
                <Button x:Name="BtnNeutral" Content="Save" MinWidth="120" Padding="16,9" Visibility="Collapsed"
                        FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                        Background="{DynamicResource AccentBrush}" Cursor="Hand" BorderThickness="0"
                        Template="{StaticResource DialogButton}" Click="Neutral_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
