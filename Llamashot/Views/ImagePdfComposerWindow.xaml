<Window x:Class="Llamashot.Views.ImagePdfComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Llamashot.Core"
        Icon="/Resources/icon32.png"
        Title="Images to PDF — Composer"
        Width="1080" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowGradientBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Cap">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Button" x:Key="Tool">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Accent" BasedOn="{StaticResource Tool}">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Selection handles -->
        <Style TargetType="Thumb" x:Key="CornerHandle">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Thumb" x:Key="RotateHandle">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource AccentBrush}" BorderBrush="White"
                                BorderThickness="2" CornerRadius="8" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource HeaderGradientBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Images &#x2192; PDF" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="PAGE SIZE" Style="{StaticResource Cap}" />
                    <ComboBox x:Name="CmbPageSize" Width="118" Height="30" SelectionChanged="PageSize_Changed" />
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="ORIENTATION" Style="{StaticResource Cap}" />
                    <ComboBox x:Name="CmbOrient" Width="110" Height="30" SelectionChanged="PageSize_Changed">
                        <ComboBoxItem Content="Portrait" IsSelected="True" />
                        <ComboBoxItem Content="Landscape" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,16,0" Width="170">
                    <TextBlock x:Name="TxtMargin" Text="MARGIN — 24 pt" Style="{StaticResource Cap}" />
                    <Slider x:Name="SldMargin" Minimum="0" Maximum="120" Value="24" Height="30"
                            VerticalAlignment="Center" ValueChanged="Margin_Changed" />
                </StackPanel>

                <Button x:Name="BtnAddImages" Content="&#x2795;  Add Images" Style="{StaticResource Tool}"
                        Margin="0,16,8,0" Click="AddImages_Click" />
                <Button x:Name="BtnScanAdd" Content="&#x25A4;  Scan &amp; Add" Style="{StaticResource Tool}"
                        Margin="0,16,8,0" Click="ScanAdd_Click"
                        ToolTip="Photograph a document, flatten it to a rectangle, and add it to this page" />
                <Button x:Name="BtnAddPage" Content="&#x1F4C4;  Add Page" Style="{StaticResource Tool}"
                        Margin="0,16,8,0" Click="AddPage_Click" />
                <Button x:Name="BtnExport" Content="&#x2B07;  Export PDF" Style="{StaticResource Accent}"
                        Margin="0,16,0,0" Click="Export_Click" />
            </WrapPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="248" />
            </Grid.ColumnDefinitions>

            <!-- Pages rail -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PAGES" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" FontWeight="SemiBold" Margin="14,12,14,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" core:SmoothScroll.Enabled="True" Padding="10,0,10,12">
                        <StackPanel x:Name="ThumbList" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Page canvas -->
            <Grid x:Name="CenterHost" Grid.Column="1" Background="{DynamicResource WindowBrush}"
                  SizeChanged="CenterHost_SizeChanged" ClipToBounds="True"
                  MouseLeftButtonDown="Center_MouseDown">
                <Border x:Name="PageHost" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="#000000" />
                    </Border.Effect>
                    <Canvas x:Name="PageCanvas" ClipToBounds="False" />
                </Border>
            </Grid>

            <!-- Properties -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" core:SmoothScroll.Enabled="True">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="SELECTED IMAGE" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock x:Name="TxtNoSel" Text="No image selected.&#x0a;Add images, then click one on the page to move, resize or rotate it."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap" />

                        <StackPanel x:Name="PropsPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Rotation" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock x:Name="TxtRotate" Text="0&#xB0;" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="SldRotate" Minimum="0" Maximum="360" Value="0" ValueChanged="Rotate_Changed" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="&#x21BA; -90" Style="{StaticResource Tool}" Padding="8,5" Click="RotL_Click" Margin="0,0,6,0" />
                                <Button Content="+90 &#x21BB;" Style="{StaticResource Tool}" Padding="8,5" Click="RotR_Click" Margin="0,0,6,0" />
                                <Button Content="0&#xB0;" Style="{StaticResource Tool}" Padding="10,5" Click="Rot0_Click" />
                            </StackPanel>

                            <TextBlock Text="DOCUMENT" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                            <Button x:Name="BtnRescan" Content="&#x25A4;  Scan / Flatten this image" Style="{StaticResource Tool}"
                                    HorizontalContentAlignment="Left" Padding="12,7" Click="Rescan_Click"
                                    ToolTip="Perspective-crop this photo to a flat rectangle (great for skewed ID cards / receipts)" />

                            <TextBlock Text="FLIP" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                            <UniformGrid Columns="2">
                                <Button x:Name="BtnFlipH" Content="&#x21C6;  Horizontal" Style="{StaticResource Tool}"
                                        Margin="0,0,6,0" Click="FlipH_Click" />
                                <Button x:Name="BtnFlipV" Content="&#x21C5;  Vertical" Style="{StaticResource Tool}"
                                        Margin="0,0,0,0" Click="FlipV_Click" />
                            </UniformGrid>

                            <TextBlock x:Name="TxtSize" Text="Size: —" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12" Margin="0,14,0,0" />

                            <TextBlock Text="ARRANGE" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                            <UniformGrid Columns="2">
                                <Button Content="Center" Style="{StaticResource Tool}" Margin="0,0,6,6" Click="Center_Click" />
                                <Button Content="Fit page" Style="{StaticResource Tool}" Margin="0,0,0,6" Click="Fit_Click" />
                                <Button Content="To front" Style="{StaticResource Tool}" Margin="0,0,6,6" Click="Front_Click" />
                                <Button Content="To back" Style="{StaticResource Tool}" Margin="0,0,0,6" Click="Back_Click" />
                                <Button Content="Duplicate" Style="{StaticResource Tool}" Margin="0,0,6,0" Click="Dup_Click" />
                                <Button Content="Delete" Style="{StaticResource Tool}" Margin="0,0,0,0" Click="Del_Click"
                                        Foreground="{DynamicResource DangerBrush}" />
                            </UniformGrid>
                        </StackPanel>

                        <TextBlock Text="TIPS" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8" />
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="• Drag a corner to resize, the top dot to rotate.&#x0a;• Hold Shift while rotating to snap to 15°.&#x0a;• Drag the image body to move it.&#x0a;• Arrow keys nudge; Delete removes; Esc deselects.&#x0a;• Add multiple images for ID cards or documents." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
