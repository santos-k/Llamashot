<Window x:Class="Llamashot.Views.GifQualityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="320" Height="260"
        PreviewKeyDown="Window_KeyDown">
    <Border CornerRadius="12" Padding="16"
            BorderThickness="1"
            Background="{DynamicResource SurfaceGradientBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="4" Color="#000020" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Save Quality" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <!-- Original -->
            <Button x:Name="BtnOriginal" Click="Original_Click" Cursor="Hand" Focusable="False" Margin="0,0,0,6">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,8"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Original" Foreground="#4CAF50" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtOriginalDesc" Text=" — Full resolution" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtOriginalSub" Text="Best quality, larger file size" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#404CAF50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- High -->
            <Button x:Name="BtnHigh" Click="High_Click" Cursor="Hand" Focusable="False" Margin="0,0,0,6">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,8"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="High" Foreground="#42A5F5" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text=" — 720p" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Good quality, moderate file size" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4042A5F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Compact -->
            <Button x:Name="BtnCompact" Click="Compact_Click" Cursor="Hand" Focusable="False" Margin="0,0,0,6">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,8"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Compact" Foreground="#FFA726" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text=" — 480p" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Smallest file, good for sharing" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFA726" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Cancel -->
            <Button Click="Cancel_Click" Cursor="Hand" Focusable="False" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tb" Text="Cancel" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tb" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
