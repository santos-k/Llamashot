<Window x:Class="Llamashot.Views.ToolWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="Llamashot - PDF Workspace"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <!-- Rail tool button -->
        <ControlTemplate x:Key="RailItem" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="11,9">
                <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="Pill" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="999"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="14,7">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="SoftBtn" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- themed ComboBox (so the dropdown popup follows light/dark theme) -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                      Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="ThemedComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemedCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Background="{TemplateBinding Background}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                              Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25" Color="#000000"/></Border.Effect>
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColNav" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ LEFT RAIL ============ -->
        <Border x:Name="NavPanel" Grid.Column="0" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16">
                <!-- brand -->
                <Grid DockPanel.Dock="Top" Margin="4,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="L" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock Text="Llamashot" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="PDF Tools" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="⟨" ToolTip="Collapse sidebar"
                            Click="CollapseNav_Click" Width="30" Height="30" Template="{StaticResource SoftBtn}"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                </Grid>

                <Button DockPanel.Dock="Top" x:Name="BtnAddFiles" Click="AddFiles_Click" Height="44" Margin="2,0,2,14"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="14"
                        Template="{StaticResource SoftBtn}" Content="+  Add Files"/>

                <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="10,4,0,6"/>
                <Button DockPanel.Dock="Top" Template="{StaticResource RailItem}" Background="Transparent" Cursor="Hand" Margin="0,1">
                    <TextBlock Text="🗂   All Files" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5"/>
                </Button>
                <Button DockPanel.Dock="Top" Template="{StaticResource RailItem}" Background="Transparent" Cursor="Hand" Margin="0,1">
                    <TextBlock Text="🕒   Recent Files" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5"/>
                </Button>
                <Button DockPanel.Dock="Top" Template="{StaticResource RailItem}" Background="Transparent" Cursor="Hand" Margin="0,1">
                    <TextBlock Text="⭐   Starred" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5"/>
                </Button>

                <TextBlock DockPanel.Dock="Top" Text="PDF TOOLS" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="10,16,0,6"/>
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RailTools"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- collapsed sidebar rail -->
        <Border x:Name="NavRail" Grid.Column="0" Width="54" Visibility="Collapsed"
                Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,1,0" Cursor="Hand" ToolTip="Expand sidebar" MouseLeftButtonUp="ExpandNav_Click">
            <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center">
                <Button Content="☰" Click="ExpandNav_Click" Width="34" Height="34" Template="{StaticResource SoftBtn}"
                        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                <Border Width="34" Height="34" CornerRadius="10" Margin="0,14,0,0" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="L" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ MAIN ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top bar -->
            <Border Grid.Row="0" Padding="26,18" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="Split PDF" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtSubtitle" Text="Split PDF pages into multiple files" FontSize="13.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" x:Name="BtnTheme" Click="Theme_Click" Template="{StaticResource SoftBtn}"
                            Background="{DynamicResource SurfaceBrush}" Padding="13,8" Cursor="Hand">
                        <TextBlock x:Name="TxtTheme" Text="🌙  Theme" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 3 columns: files | preview (large) | info + settings -->
            <Grid Grid.Row="1" Margin="26,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColFiles" Width="1*"/>
                    <ColumnDefinition x:Name="ColPreview" Width="1.6*"/>
                    <ColumnDefinition x:Name="ColInfo" Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== LEFT: files management ===== -->
                <Border x:Name="LeftPanel" Grid.Column="0" Margin="0,0,9,0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16"
                        AllowDrop="True" Drop="Preview_Drop" DragOver="Preview_DragOver">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="18,16" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLeftTitle" Text="Source File" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="TxtLeftSub" Text="The PDF you want to work on" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnAddMore" Grid.Column="1" Content="+ Add More" Click="AddFiles_Click" Template="{StaticResource SoftBtn}"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="13,8" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="⟨" ToolTip="Collapse panel" Click="CollapseLeft_Click" Width="32" Height="32" Margin="8,0,0,0"
                                        Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel x:Name="LeftHost"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- collapsed rail for the left files panel -->
                <Border x:Name="LeftRail" Grid.Column="0" Margin="0,0,9,0" Width="46" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="16" Cursor="Hand" ToolTip="Show files"
                        MouseLeftButtonUp="ExpandLeft_Click">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="⟩" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="📁" FontSize="18" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtRailLabel" Text="Files" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== CENTER: large unified preview ===== -->
                <Border Grid.Column="1" Margin="9,0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <!-- empty -->
                        <StackPanel x:Name="CenterEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtCenterEmptyIcon" Text="📄" FontSize="46" HorizontalAlignment="Center" Opacity="0.75"/>
                            <TextBlock x:Name="TxtCenterEmptyTitle" Text="Nothing to preview yet" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock x:Name="TxtCenterEmptySub" Text="Add a file on the left to see it here" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- loaded preview -->
                        <DockPanel x:Name="PreviewState" Visibility="Collapsed">
                            <!-- header: title + pager + zoom -->
                            <Border DockPanel.Dock="Top" Padding="18,12" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPreviewTitle" Text="Preview" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock x:Name="TxtPreviewSub" Text="Total 0 pages" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="‹" Click="PrevPage_Click" Width="32" Height="32" Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="14,6" Margin="8,0">
                                            <TextBlock x:Name="TxtPager" Text="1 / 1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
                                        </Border>
                                        <Button Content="›" Click="NextPage_Click" Width="32" Height="32" Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                        <Border Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="14,4"/>
                                        <Button Content="−" Click="ZoomOut_Click" Width="32" Height="32" Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                        <TextBlock x:Name="TxtZoom" Text="100%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" Width="48" TextAlignment="Center"/>
                                        <Button Content="+" Click="ZoomIn_Click" Width="32" Height="32" Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                        <Button Content="⛶" Click="FitZoom_Click" ToolTip="View fullscreen" Width="32" Height="32" Margin="8,0,0,0" Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- filmstrip -->
                            <Border DockPanel.Dock="Bottom" Padding="10,10" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="‹" Click="FilmPrev_Click" Width="28" Height="60" Margin="0,0,8,0" Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                    <Button DockPanel.Dock="Right" Content="›" Click="FilmNext_Click" Width="28" Height="60" Margin="8,0,0,0" Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                    <ScrollViewer x:Name="ThumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ThumbList">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <!-- big page -->
                            <ScrollViewer x:Name="PreviewScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20" Background="{DynamicResource WindowBrush}">
                                <Grid x:Name="PreviewStack" HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <Image x:Name="PreviewImage" Stretch="Fill" Width="540"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ===== RIGHT: info + tips + settings ===== -->
                <DockPanel x:Name="RightPanel" Grid.Column="2" Margin="9,0,0,0">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="⟩" ToolTip="Collapse panel" Click="CollapseRight_Click"
                            Width="32" Height="32" Margin="0,0,0,10" Template="{StaticResource SoftBtn}"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="File Information" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnInfoToggle" HorizontalAlignment="Right" Content="▾" ToolTip="Collapse" Click="CollapseInfo_Click" Width="28" Height="28"
                                            Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                </Grid>
                                <StackPanel x:Name="InfoRows"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="💡 Helpful Tips" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnTipToggle" HorizontalAlignment="Right" Content="▾" ToolTip="Collapse" Click="CollapseTip_Click" Width="28" Height="28"
                                            Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                </Grid>
                                <TextBlock x:Name="TxtTip" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Choose a split method, set your page range, and pick an output folder."/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Tool Settings" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnSettingsToggle" HorizontalAlignment="Right" Content="▾" ToolTip="Collapse" Click="CollapseSettings_Click" Width="28" Height="28"
                                            Template="{StaticResource SoftBtn}" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"/>
                                </Grid>
                                <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="SettingsHost"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- collapsed rail for the right info/settings panel -->
                <Border x:Name="RightRail" Grid.Column="2" Margin="9,0,0,0" Width="46" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="16" Cursor="Hand" ToolTip="Show info &amp; settings"
                        MouseLeftButtonUp="ExpandRight_Click">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="⟨" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="⚙" FontSize="18" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Settings" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ACTION BAR -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="26,16">
                <Grid>
                    <Button HorizontalAlignment="Left" Content="🗑  Clear All" Click="Clear_Click" Template="{StaticResource SoftBtn}"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="18,11" Cursor="Hand"/>
                    <TextBlock x:Name="TxtSelection" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="No file selected" Foreground="{DynamicResource TextMutedBrush}" FontSize="13.5"/>
                    <Button x:Name="BtnProcess" HorizontalAlignment="Right" Click="Process_Click" Template="{StaticResource SoftBtn}"
                            Background="{DynamicResource AccentBrush}" Foreground="White" Padding="34,14" Cursor="Hand" FontWeight="Bold" FontSize="15">
                        <TextBlock x:Name="TxtProcess" Text="Split PDF  →"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ PROCESSING OVERLAY ============ -->
        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="{DynamicResource ScrimBrush}" Panel.ZIndex="100">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="44,36"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="330">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="60" Height="60" HorizontalAlignment="Center">
                        <Ellipse Width="60" Height="60" StrokeThickness="6" Stroke="{DynamicResource SurfaceAltBrush}"/>
                        <Path Width="60" Height="60" Stroke="{DynamicResource AccentBrush}" StrokeThickness="6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 30,4 A 26,26 0 1 1 4,30" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="TxtBusyTitle" Text="Processing…" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,5"/>
                    <TextBlock x:Name="TxtBusySub" Text="Please wait" FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button x:Name="BtnBusyCancel" Content="Stop" Visibility="Collapsed"
                            Click="BtnBusyCancel_Click" Margin="0,18,0,0" Padding="22,8" Cursor="Hand"
                            HorizontalAlignment="Center" FontSize="12.5"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
