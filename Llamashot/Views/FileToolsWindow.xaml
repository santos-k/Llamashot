<Window x:Class="Llamashot.Views.FileToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="Llamashot - File Tools"
        Width="850" Height="680"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#1A1A1E">

    <Window.Resources>
        <!-- Rounded button template (reusable) -->
        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="25"
                    Padding="{TemplateBinding Padding}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Smaller rounded button (21 radius) -->
        <ControlTemplate x:Key="RoundedButton21" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="21"
                    Padding="{TemplateBinding Padding}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- File list item template (with index, name, extra, size, remove button) -->
        <DataTemplate x:Key="FileListItemTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Index}" Foreground="#666" FontSize="11" Width="24" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#CCC" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="#888" FontSize="10"
                           VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding FileSize}" Foreground="#666" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="X" Width="22" Height="22" FontSize="11"
                        Background="#333" Foreground="#EF5350" BorderBrush="#444" Cursor="Hand"
                        Tag="{Binding FilePath}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Image file list item template (with thumbnail) -->
        <DataTemplate x:Key="ImageFileListItemTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Index}" Foreground="#666" FontSize="11" Width="24" VerticalAlignment="Center"/>
                <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="#CCC" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FileSize}" Foreground="#666" FontSize="10"/>
                </StackPanel>
                <Button Grid.Column="4" Content="X" Width="22" Height="22" FontSize="11"
                        Background="#333" Foreground="#EF5350" BorderBrush="#444" Cursor="Hand"
                        Tag="{Binding FilePath}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!--  Row 0: Header                                                   -->
        <!-- ================================================================ -->
        <Border Grid.Row="0" Background="#222" Padding="16,10" BorderBrush="#333" BorderThickness="0,0,0,1">
            <Grid>
                <Button x:Name="BtnBack" Content="&#x2190; Back" HorizontalAlignment="Left" Visibility="Collapsed"
                        Click="GoBack_Click" Background="Transparent" Foreground="#CCC" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Padding="8,4"/>
                <TextBlock x:Name="TxtToolTitle" Text="File Tools" FontSize="20" FontWeight="SemiBold"
                           Foreground="#EEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!--  Row 1: Content                                                  -->
        <!-- ================================================================ -->

        <!-- Home Panel: search + card grid -->
        <Grid x:Name="HomePanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Search + Sort bar -->
            <Grid Margin="24,12,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtToolSearch" Height="36" Padding="12,6" FontSize="13"
                         Background="#1E1E24" Foreground="#EEE" BorderBrush="#333" BorderThickness="1"
                         VerticalContentAlignment="Center" TextChanged="ToolSearch_Changed">
                    <TextBox.Style>
                        <Style TargetType="TextBox"/>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="&#x1F50D; Search tools..." Foreground="#555" FontSize="13"
                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"
                           x:Name="TxtSearchPlaceholder"/>
                <ComboBox x:Name="CmbToolSort" Grid.Column="1" Width="140" Height="36" FontSize="12"
                          SelectedIndex="0" Margin="10,0,0,0" SelectionChanged="ToolSort_Changed">
                    <ComboBoxItem Content="Group by category"/>
                    <ComboBoxItem Content="Sort A-Z"/>
                    <ComboBoxItem Content="Sort Z-A"/>
                </ComboBox>
            </Grid>
            <!-- Card container -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CardPanel" Margin="20,8,20,16"/>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 1. PanelMergePdf ====================== -->
        <Grid x:Name="PanelMergePdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="MergeSelectView" AllowDrop="True"
                          Drop="MergePdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Merge PDF files" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Combine PDFs in the order you want" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button x:Name="BtnMergeSelect" Content="Select PDF files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#E53935" Cursor="Hand" Click="MergePdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop PDFs here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="MergeConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="#42A5F5" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="MergePdf_AddMore"/>
                    <ListBox x:Name="MergePdfList" Background="#252528" Foreground="#CCC"
                             BorderBrush="#333" BorderThickness="1" MaxHeight="280" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="#555" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#CCC" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="#42A5F5" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FileSize}" Foreground="#666" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="4" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="#42A5F5" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="5" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="#EF5350" BorderThickness="0" Cursor="Hand"
                                            Click="MergePdf_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Merge PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#E53935"
                            HorizontalAlignment="Center" Cursor="Hand" Click="MergePdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 2. PanelSplitPdf ====================== -->
        <Grid x:Name="PanelSplitPdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="SplitSelectView" AllowDrop="True"
                          Drop="SplitPdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Split PDF" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Extract specific pages from a PDF" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#FF7043" Cursor="Hand" Click="SplitPdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="SplitConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtSplitFileName" Text="" Foreground="#CCC" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSplitInfo" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,20"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="From page:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSplitFrom" Grid.Column="1" Height="28" Padding="6,4" FontSize="12"
                                 Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444" Text="1"/>
                        <TextBlock Text="To page:" Grid.Column="2" Foreground="#CCC" FontSize="13"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="TxtSplitTo" Grid.Column="3" Height="28" Padding="6,4" FontSize="12"
                                 Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444"/>
                    </Grid>
                    <Button Content="Split PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#FF7043"
                            HorizontalAlignment="Center" Cursor="Hand" Click="SplitPdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 3. PanelCompressPdf ====================== -->
        <Grid x:Name="PanelCompressPdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CompressPdfSelectView" AllowDrop="True"
                          Drop="CompressPdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Compress PDF" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Reduce the size of your PDF" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#EF5350" Cursor="Hand" Click="CompressPdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="CompressPdfConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtCompressPdfFileName" Text="" Foreground="#CCC" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtCompressPdfInfo" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,20"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldPdfQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="80"
                                VerticalAlignment="Center" ValueChanged="CompressPdf_QualityChanged"/>
                        <TextBlock x:Name="TxtPdfQualityVal" Grid.Column="2" Text="80" Foreground="#AAA" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Compress PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#EF5350"
                            HorizontalAlignment="Center" Cursor="Hand" Click="CompressPdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 4. PanelPdfToImages ====================== -->
        <Grid x:Name="PanelPdfToImages" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="PdfToImgSelectView" AllowDrop="True"
                          Drop="PdfToImg_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="PDF to Images" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Convert each PDF page to an image" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#F44336" Cursor="Hand" Click="PdfToImg_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="PdfToImgConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtPdfToImgFileName" Text="" Foreground="#CCC" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtPdfToImgInfo" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,20"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Format:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbPdfImgFormat" Grid.Column="1" Width="70" Height="28" FontSize="12" SelectedIndex="0">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                        </ComboBox>
                        <TextBlock Text="DPI:" Grid.Column="2" Foreground="#CCC" FontSize="13"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="CmbPdfImgDpi" Grid.Column="3" Width="70" Height="28" FontSize="12" SelectedIndex="1">
                            <ComboBoxItem Content="72"/>
                            <ComboBoxItem Content="150"/>
                            <ComboBoxItem Content="300"/>
                        </ComboBox>
                    </Grid>
                    <Button Content="Convert to Images &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#F44336"
                            HorizontalAlignment="Center" Cursor="Hand" Click="PdfToImg_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 5. PanelImagesToPdf ====================== -->
        <Grid x:Name="PanelImagesToPdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ImgToPdfSelectView" AllowDrop="True"
                          Drop="ImgToPdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Images to PDF" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Combine your images into a single PDF" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#E91E63" Cursor="Hand" Click="ImgToPdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop images here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="ImgToPdfConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="#42A5F5" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="ImgToPdf_AddMore"/>
                    <ListBox x:Name="ImgToPdfList" Background="#252528" Foreground="#CCC"
                             BorderBrush="#333" BorderThickness="1" MaxHeight="280" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="#555" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="#CCC" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileSize}" Foreground="#666" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="#42A5F5" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="4" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="#EF5350" BorderThickness="0" Cursor="Hand"
                                            Click="ImgToPdf_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Create PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#E91E63"
                            HorizontalAlignment="Center" Cursor="Hand" Click="ImgToPdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 6. PanelRotatePdf ====================== -->
        <Grid x:Name="PanelRotatePdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="RotatePdfSelectView" AllowDrop="True"
                          Drop="RotatePdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Rotate PDF" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Rotate all pages of your PDF" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#FFA726" Cursor="Hand" Click="RotatePdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="RotatePdfConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtRotatePdfFileName" Text="" Foreground="#CCC" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtRotatePdfInfo" Text="" Foreground="#888" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#111" CornerRadius="4" BorderBrush="#333" BorderThickness="1"
                        Margin="0,0,0,12" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="RotatePdfPreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="RpRotateTransform" Angle="0"/>
                        </Image.RenderTransform>
                    </Image>
                </Border>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="&#x21BA; 90&#x00B0; CW" Width="100" Height="36" Margin="0,0,8,6" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotatePdf_CW"
                            Template="{StaticResource RoundedButton21}"/>
                    <Button Content="&#x21BB; 90&#x00B0; CCW" Width="100" Height="36" Margin="0,0,8,6" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotatePdf_CCW"
                            Template="{StaticResource RoundedButton21}"/>
                    <Button Content="180&#x00B0;" Width="70" Height="36" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotatePdf_180"
                            Template="{StaticResource RoundedButton21}"/>
                </WrapPanel>
                <Button Grid.Row="3" Content="Save Rotated PDF &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                        FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#FFA726"
                        HorizontalAlignment="Center" Cursor="Hand" Click="RotatePdf_Execute"
                        Template="{StaticResource RoundedButton}"/>
            </Grid>
        </Grid>

        <!-- ====================== 7. PanelWatermark ====================== -->
        <Grid x:Name="PanelWatermark" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="WatermarkSelectView" AllowDrop="True"
                          Drop="Watermark_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Watermark PDF" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Add a text watermark to every page" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#7E57C2" Cursor="Hand" Click="Watermark_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="WatermarkConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtWatermarkFileName" Text="" Foreground="#CCC" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Watermark text:" Foreground="#CCC" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtWatermarkText" Height="28" Padding="6,4" FontSize="12"
                             Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444" Margin="0,0,0,16"
                             Text="CONFIDENTIAL"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldWatermarkOpacity" Grid.Column="1" Minimum="10" Maximum="100" Value="30"
                                VerticalAlignment="Center" ValueChanged="Watermark_OpacityChanged"/>
                        <TextBlock x:Name="TxtWatermarkOpacityVal" Grid.Column="2" Text="30%" Foreground="#AAA" FontSize="13"
                                   Width="40" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font size:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldWatermarkFontSize" Grid.Column="1" Minimum="12" Maximum="96" Value="48"
                                VerticalAlignment="Center" ValueChanged="Watermark_FontSizeChanged"/>
                        <TextBlock x:Name="TxtWatermarkFontSizeVal" Grid.Column="2" Text="48" Foreground="#AAA" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Add Watermark &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#7E57C2"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Watermark_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 8. PanelPageNumbers ====================== -->
        <Grid x:Name="PanelPageNumbers" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="PageNumSelectView" AllowDrop="True"
                          Drop="PageNum_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Page Numbers" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Add page numbers to your PDF" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#5C6BC0" Cursor="Hand" Click="PageNum_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="PageNumConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtPageNumFileName" Text="" Foreground="#CCC" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Position:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbPageNumPos" Grid.Column="1" Width="150" Height="28" FontSize="12" SelectedIndex="0">
                            <ComboBoxItem Content="Bottom Center"/>
                            <ComboBoxItem Content="Bottom Right"/>
                            <ComboBoxItem Content="Top Center"/>
                            <ComboBoxItem Content="Top Right"/>
                        </ComboBox>
                    </Grid>
                    <Button Content="Add Page Numbers &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#5C6BC0"
                            HorizontalAlignment="Center" Cursor="Hand" Click="PageNum_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 9. PanelExtractPages ====================== -->
        <Grid x:Name="PanelExtractPages" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ExtractSelectView" AllowDrop="True"
                          Drop="Extract_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Extract Pages" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Pick specific pages from a PDF" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#FF8A65" Cursor="Hand" Click="Extract_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="ExtractConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtExtractFileName" Text="" Foreground="#CCC" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtExtractInfo" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Click pages to select/deselect. Selected pages will be extracted." Foreground="#666" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Page thumbnail grid -->
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <WrapPanel x:Name="ExtractPageGrid" HorizontalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Selection info -->
                    <TextBlock x:Name="TxtExtractSelection" Text="No pages selected" Foreground="#42A5F5" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Button Content="Extract Selected Pages &#x2192;" Width="300" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#FF8A65"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Extract_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 10. PanelInsertPages ====================== -->
        <Grid x:Name="PanelInsertPages" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="InsertSelectView" AllowDrop="True"
                          Drop="Insert_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Insert Pages" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Add new pages to an existing PDF" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select base PDF" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#A1887F" Cursor="Hand" Click="Insert_SelectBase"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="InsertConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtInsertBaseName" Text="" Foreground="#CCC" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtInsertBaseInfo" Text="" Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Click a &#x2295; button between pages to set insertion point, then add images." Foreground="#666" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Page flow with insertion points -->
                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <WrapPanel x:Name="InsertPageGrid" HorizontalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Insertion point indicator -->
                    <TextBlock x:Name="TxtInsertPosition" Text="Insert position: beginning" Foreground="#42A5F5" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Image drop zone -->
                    <TextBlock Text="Images to insert:" Foreground="#CCC" FontSize="13" Margin="0,0,0,6"/>
                    <Border Background="#1E1E22" BorderBrush="#444" BorderThickness="2" CornerRadius="6"
                            Padding="14" Cursor="Hand" Margin="0,0,0,8" AllowDrop="True"
                            Drop="Insert_ImageDrop" DragOver="Generic_DragOver"
                            MouseLeftButtonDown="Insert_BrowseImages">
                        <TextBlock Text="Drop images here or click to browse" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <ListBox x:Name="InsertImageList" Background="#252528" Foreground="#CCC"
                             BorderBrush="#333" BorderThickness="1" MaxHeight="120" MinHeight="30"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="#555" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#CCC" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="#666" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="#EF5350" BorderThickness="0" Cursor="Hand"
                                            Click="Insert_RemoveImage" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="Insert Pages &#x2192;" Width="300" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#A1887F"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Insert_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 11. PanelCompressImage ====================== -->
        <Grid x:Name="PanelCompressImage" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CompressImgSelectView" AllowDrop="True"
                          Drop="CompressImg_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Compress Images" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Reduce image file size while maintaining quality" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#26C6DA" Cursor="Hand" Click="CompressImg_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop images here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="CompressImgConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="#42A5F5" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="CompressImg_AddMore"/>
                    <ListBox x:Name="CompressImgList" Background="#252528" Foreground="#CCC"
                             BorderBrush="#333" BorderThickness="1" MaxHeight="200" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="#555" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="#CCC" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileSize}" Foreground="#666" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="#42A5F5" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="4" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="#EF5350" BorderThickness="0" Cursor="Hand"
                                            Click="CompressImg_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldImgQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="80"
                                VerticalAlignment="Center" ValueChanged="CompressImg_QualityChanged"/>
                        <TextBlock x:Name="TxtImgQualityVal" Grid.Column="2" Text="80" Foreground="#AAA" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max dimension:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtImgMaxDim" Grid.Column="1" Height="28" Padding="6,4" FontSize="12"
                                 Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444"/>
                        <TextBlock Grid.Column="2" Text="px (empty = no limit)" Foreground="#666" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Compress All &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#26C6DA"
                            HorizontalAlignment="Center" Cursor="Hand" Click="CompressImg_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 12. PanelResizeImage ====================== -->
        <Grid x:Name="PanelResizeImage" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ResizeSelectView" AllowDrop="True"
                          Drop="Resize_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Resize Image" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Change the dimensions of your image" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#26A69A" Cursor="Hand" Click="Resize_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ResizeConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtResizeFileName" Text="" Foreground="#CCC" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtResizeInfo" Text="" Foreground="#888" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#111" CornerRadius="4" BorderBrush="#333" BorderThickness="1"
                        Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="ResizePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Row="2">
                    <!-- Resize mode selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbResizePixels" Content="Pixels" Foreground="#CCC" FontSize="12"
                                     IsChecked="True" GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizePercent" Content="Percentage" Foreground="#CCC" FontSize="12"
                                     GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizeInches" Content="Inches" Foreground="#CCC" FontSize="12"
                                     GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizeCm" Content="cm" Foreground="#CCC" FontSize="12"
                                     GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizeMm" Content="mm" Foreground="#CCC" FontSize="12"
                                     GroupName="ResizeUnit" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtResizeWLabel" Text="Width:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtResizeW" Grid.Column="1" Height="28" Padding="6,4" FontSize="12"
                                 Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444" TextChanged="ResizeW_Changed"/>
                        <TextBlock x:Name="TxtResizeHLabel" Text="Height:" Grid.Column="2" Foreground="#CCC" FontSize="13"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="TxtResizeH" Grid.Column="3" Height="28" Padding="6,4" FontSize="12"
                                 Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444" TextChanged="ResizeH_Changed"/>
                        <TextBlock x:Name="TxtResizeUnit" Grid.Column="4" Text="px" Foreground="#666" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <!-- DPI input for physical units -->
                    <Grid x:Name="ResizeDpiRow" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DPI:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtResizeDpi" Height="28" Padding="6,4" FontSize="12"
                                 Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444" Text="96" Grid.Column="1"/>
                        <TextBlock Text="(dots per inch)" Foreground="#666" FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Grid.Column="2"/>
                    </Grid>
                    <CheckBox x:Name="ChkResizeAspect" Content="Maintain aspect ratio" Foreground="#CCC" FontSize="12"
                              IsChecked="True" Margin="0,0,0,4" Cursor="Hand"/>
                    <!-- Output pixel size preview -->
                    <TextBlock x:Name="TxtResizeOutput" Text="" Foreground="#42A5F5" FontSize="12" Margin="0,0,0,8"/>
                    <Button Content="Resize &amp; Save &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#26A69A"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Resize_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ====================== 13. PanelCropImage ====================== -->
        <Grid x:Name="PanelCropImage" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CropSelectView" AllowDrop="True"
                          Drop="Crop_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Crop Image" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Crop your image to a specific area" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#42A5F5" Cursor="Hand" Click="Crop_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="CropConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtCropFileName" Text="" Foreground="#CCC" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtCropImgSize" Text="" Foreground="#888" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#111" CornerRadius="4" BorderBrush="#333" BorderThickness="1"
                        Margin="0,0,0,8" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Grid x:Name="CropContainer">
                        <Image x:Name="CropPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="CropCanvas" Background="Transparent"
                                MouseLeftButtonDown="CropCanvas_MouseDown"
                                MouseMove="CropCanvas_MouseMove"
                                MouseLeftButtonUp="CropCanvas_MouseUp"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtCropInfo" Text="Draw a crop area on the image" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkCropAspect" Content="Lock ratio" Foreground="#CCC" FontSize="12" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="Reset" Width="60" Height="26" FontSize="11" Background="#333" Foreground="#CCC"
                                BorderBrush="#444" Cursor="Hand" Click="Crop_Reset"/>
                    </StackPanel>
                </Grid>
                <Button Grid.Row="3" Content="Crop &amp; Save &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                        FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#42A5F5"
                        HorizontalAlignment="Center" Cursor="Hand" Click="Crop_Execute"
                        Template="{StaticResource RoundedButton}"/>
            </Grid>
        </Grid>

        <!-- ====================== 14. PanelRotateFlip ====================== -->
        <Grid x:Name="PanelRotateFlip" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="RotateFlipSelectView" AllowDrop="True"
                          Drop="RotateFlip_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Rotate &amp; Flip" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Rotate or flip your image" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#AB47BC" Cursor="Hand" Click="RotateFlip_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="RotateFlipConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtRotateFlipFileName" Text="" Foreground="#CCC" FontSize="14"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="#111" CornerRadius="4" BorderBrush="#333" BorderThickness="1"
                        Margin="0,0,0,12" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="RotateFlipPreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RfFlipTransform" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="RfRotateTransform" Angle="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Border>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="&#x21BA; 90&#x00B0;" Width="80" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotateFlip_CW"/>
                    <Button Content="&#x21BB; 90&#x00B0;" Width="80" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotateFlip_CCW"/>
                    <Button Content="180&#x00B0;" Width="60" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotateFlip_180"/>
                    <Button Content="&#x2194; Flip H" Width="80" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotateFlip_FlipH"/>
                    <Button Content="&#x2195; Flip V" Width="80" Height="36" Margin="0,0,0,6" FontSize="13"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand" Click="RotateFlip_FlipV"/>
                </WrapPanel>
                <Button Grid.Row="3" Content="Save &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                        FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#AB47BC"
                        HorizontalAlignment="Center" Cursor="Hand" Click="RotateFlip_Execute"
                        Template="{StaticResource RoundedButton}"/>
            </Grid>
        </Grid>

        <!-- ====================== 15. PanelConvertFormat ====================== -->
        <Grid x:Name="PanelConvertFormat" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ConvertSelectView" AllowDrop="True"
                          Drop="Convert_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Convert Image" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Convert your image to a different format" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#EC407A" Cursor="Hand" Click="Convert_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ConvertConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtConvertFileName" Text="" Foreground="#CCC" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtConvertInfo" Text="" Foreground="#888" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#111" CornerRadius="4" BorderBrush="#333" BorderThickness="1"
                        Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="ConvertPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target format:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbConvertFormat" Grid.Column="1" Width="100" Height="28" FontSize="12" SelectedIndex="0"
                                  SelectionChanged="Convert_FormatChanged">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                            <ComboBoxItem Content="BMP"/>
                            <ComboBoxItem Content="GIF"/>
                            <ComboBoxItem Content="TIFF"/>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="ConvertQualityPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JPEG quality:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldConvertQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="90"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtConvertQualityVal" Grid.Column="2" Text="90" Foreground="#AAA" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Convert &#x2192;" Width="280" Height="50" Margin="0,8,0,12"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#EC407A"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Convert_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ====================== 16. PanelCompressOffice ====================== -->
        <Grid x:Name="PanelCompressOffice" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CompressOfficeSelectView" AllowDrop="True"
                          Drop="CompressOffice_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Compress Office" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Reduce Office document file size" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select Office files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#78909C" Cursor="Hand" Click="CompressOffice_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop Office files here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="CompressOfficeConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="#42A5F5" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="CompressOffice_AddMore"/>
                    <ListBox x:Name="CompressOfficeList" Background="#252528" Foreground="#CCC"
                             BorderBrush="#333" BorderThickness="1" MaxHeight="200" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="#555" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#CCC" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="#888" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="3" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="#42A5F5" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="4" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="#EF5350" BorderThickness="0" Cursor="Hand"
                                            Click="CompressOffice_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality:" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldOfficeQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="80"
                                VerticalAlignment="Center" ValueChanged="CompressOffice_QualityChanged"/>
                        <TextBlock x:Name="TxtOfficeQualityVal" Grid.Column="2" Text="80" Foreground="#AAA" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Compress All &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#78909C"
                            HorizontalAlignment="Center" Cursor="Hand" Click="CompressOffice_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 17. PanelVideoTools (unified) ====================== -->
        <Grid x:Name="PanelVideoTools" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="VideoSelectView" AllowDrop="True"
                          Drop="VideoTools_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Video Tools" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Trim, crop, rotate, flip &amp; export" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select video file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#F44336" Cursor="Hand" Click="VideoTools_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a video here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== Video Editor: 3-panel layout ===== -->
            <Grid x:Name="VideoConfigView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- File info bar -->
                    <RowDefinition Height="*"/>      <!-- Main 3-column area -->
                    <RowDefinition Height="Auto"/>   <!-- Timeline -->
                    <RowDefinition Height="Auto"/>   <!-- Bottom bar -->
                </Grid.RowDefinitions>

                <!-- Row 0: File info bar -->
                <Border Background="#1A1A1E" Padding="12,6" BorderBrush="#333" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVideoFileName" Text="" Foreground="#CCC" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtVideoInfo" Text="" Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Left sidebar + Center preview + Right properties -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>    <!-- Tool sidebar -->
                        <ColumnDefinition Width="*"/>     <!-- Preview -->
                        <ColumnDefinition Width="210"/>   <!-- Properties -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Tool sidebar -->
                    <Border Background="#161619" BorderBrush="#2A2A2E" BorderThickness="0,0,1,0">
                        <StackPanel Margin="0,12,0,0">
                            <Button x:Name="BtnToolTrim" Tag="trim" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x2702;" FontSize="18" Foreground="#888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Trim" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolCrop" Tag="crop" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x2B1C;" FontSize="16" Foreground="#888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Crop" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolRotate" Tag="rotate" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x21BB;" FontSize="18" Foreground="#888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rotate" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolFlip" Tag="flip" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x21C5;" FontSize="18" Foreground="#888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Flip" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolInfo" Tag="info" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x24D8;" FontSize="16" Foreground="#888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Info" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- CENTER: Video preview + playback controls -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>     <!-- Preview -->
                            <RowDefinition Height="Auto"/>  <!-- Playback controls -->
                        </Grid.RowDefinitions>

                        <!-- Video preview -->
                        <Border Background="#000" Margin="0">
                            <Grid ClipToBounds="True">
                                <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" MediaOpened="VideoPreview_MediaOpened"
                                              MediaEnded="VideoPreview_MediaEnded">
                                    <MediaElement.LayoutTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="VideoFlipTransform" ScaleX="1" ScaleY="1"/>
                                            <RotateTransform x:Name="VideoRotateTransform" Angle="0"/>
                                        </TransformGroup>
                                    </MediaElement.LayoutTransform>
                                </MediaElement>
                                <Canvas x:Name="VideoCropCanvas" Background="Transparent" Visibility="Collapsed"
                                        MouseLeftButtonDown="VideoCrop_MouseDown"
                                        MouseMove="VideoCrop_MouseMove"
                                        MouseLeftButtonUp="VideoCrop_MouseUp"/>
                            </Grid>
                        </Border>

                        <!-- Playback controls bar -->
                        <Border Grid.Row="1" Background="#1A1A1E" Padding="10,6" BorderBrush="#2A2A2E" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Time -->
                                <TextBlock x:Name="TxtVideoTime" Foreground="#4DB6AC" FontSize="12"
                                           VerticalAlignment="Center" Text="00:00:00 / 00:00:00"/>
                                <!-- Playback buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="&#x23EE;" FontSize="16" Width="32" Height="32"
                                            Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand"
                                            Click="VideoSetTrimStart" ToolTip="Jump to start"/>
                                    <Button x:Name="BtnVideoPlay" Content="&#x25B6;" FontSize="18" Width="38" Height="38"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            Click="VideoPlay_Click" Margin="4,0"/>
                                    <Button Content="&#x23ED;" FontSize="16" Width="32" Height="32"
                                            Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand"
                                            Click="VideoSetTrimEnd" ToolTip="Jump to end"/>
                                    <Button Content="&#x1F50A;" FontSize="13" Width="32" Height="32"
                                            Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand"
                                            Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT: Properties panel -->
                    <Border Grid.Column="2" Background="#161619" BorderBrush="#2A2A2E" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12,14,12">

                                <!-- Crop Section -->
                                <StackPanel x:Name="VideoPropCrop">
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Crop" Foreground="#EEE" FontSize="14" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Reset" Foreground="#888" FontSize="11" VerticalAlignment="Center"
                                                       Cursor="Hand" Margin="0,0,8,0" MouseLeftButtonDown="VideoCropReset_Click"/>
                                            <Button x:Name="BtnVideoCropToggle" Content="&#x2714;" Width="38" Height="22" FontSize="11"
                                                    Background="#333" Foreground="#4DB6AC" BorderBrush="#444" Cursor="Hand"
                                                    Click="VideoCrop_Toggle" ToolTip="Toggle crop"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Aspect Ratio" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbVideoCropAspect" Width="180" Height="28" FontSize="11" SelectedIndex="0"
                                              HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Free"/>
                                        <ComboBoxItem Content="16:9 (Widescreen)"/>
                                        <ComboBoxItem Content="4:3 (Standard)"/>
                                        <ComboBoxItem Content="1:1 (Square)"/>
                                        <ComboBoxItem Content="9:16 (Portrait)"/>
                                    </ComboBox>
                                    <TextBlock Text="Position" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X" Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropX" Grid.Column="1" Height="26" Padding="6,2" FontSize="11"
                                                 Background="#1A1A1E" Foreground="#CCC" BorderBrush="#333" Text="0"/>
                                        <TextBlock Grid.Column="3" Text="Y" Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropY" Grid.Column="4" Height="26" Padding="6,2" FontSize="11"
                                                 Background="#1A1A1E" Foreground="#CCC" BorderBrush="#333" Text="0"/>
                                    </Grid>
                                    <TextBlock Text="Size" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="W" Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropW" Grid.Column="1" Height="26" Padding="6,2" FontSize="11"
                                                 Background="#1A1A1E" Foreground="#CCC" BorderBrush="#333" Text="0"/>
                                        <TextBlock Grid.Column="3" Text="H" Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropH" Grid.Column="4" Height="26" Padding="6,2" FontSize="11"
                                                 Background="#1A1A1E" Foreground="#CCC" BorderBrush="#333" Text="0"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtVideoCropInfo" Text="" Foreground="#4DB6AC" FontSize="10" Margin="0,0,0,6"/>
                                    <Border Background="#2A2A2E" Height="1" Margin="0,4,0,12"/>
                                </StackPanel>

                                <!-- Rotate Section -->
                                <StackPanel x:Name="VideoPropRotate">
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Rotate" Foreground="#EEE" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reset" Foreground="#888" FontSize="11" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="VideoRotateReset_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="&#x21BA;" FontSize="18" Height="36"
                                                Background="#252528" Foreground="#CCC" BorderBrush="#333" Cursor="Hand"
                                                Click="VideoRotate_CCW" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="&#x21BB;" FontSize="18" Height="36"
                                                Background="#252528" Foreground="#CCC" BorderBrush="#333" Cursor="Hand"
                                                Click="VideoRotate_CW" Margin="0,0,4,0"/>
                                        <Border Grid.Column="2" Background="#1A1A1E" BorderBrush="#333" BorderThickness="1"
                                                CornerRadius="4" Height="36">
                                            <TextBlock x:Name="TxtVideoAngle" Text="0&#x00B0;" Foreground="#CCC" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="#2A2A2E" Height="1" Margin="0,4,0,12"/>
                                </StackPanel>

                                <!-- Flip Section -->
                                <StackPanel x:Name="VideoPropFlip">
                                    <TextBlock Text="Flip" Foreground="#EEE" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnVideoFlipH" Content="&#x2194; Horizontal" Height="36" FontSize="12"
                                                Background="#252528" Foreground="#CCC" BorderBrush="#333" Cursor="Hand"
                                                Click="VideoFlip_H"/>
                                        <Button x:Name="BtnVideoFlipV" Grid.Column="2" Content="&#x2195; Vertical" Height="36" FontSize="12"
                                                Background="#252528" Foreground="#CCC" BorderBrush="#333" Cursor="Hand"
                                                Click="VideoFlip_V"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtVideoTransform" Text="" Foreground="#4DB6AC" FontSize="10" Margin="0,0,0,4"/>
                                    <Border Background="#2A2A2E" Height="1" Margin="0,4,0,12"/>
                                </StackPanel>

                                <!-- Info Section -->
                                <StackPanel x:Name="VideoPropInfo" Visibility="Collapsed">
                                    <TextBlock Text="File Info" Foreground="#EEE" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtVideoDetailInfo" Text="" Foreground="#AAA" FontSize="11"
                                               TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Row 2: Timeline -->
                <Border Grid.Row="2" Background="#1A1A1E" Padding="8,4" BorderBrush="#2A2A2E" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Timeline bar -->
                            <RowDefinition Height="Auto"/>  <!-- Time labels -->
                        </Grid.RowDefinitions>

                        <Grid x:Name="VideoTimelineContainer" Height="44" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="VideoTimeline_MouseDown"
                              MouseMove="VideoTimeline_MouseMove"
                              MouseLeftButtonUp="VideoTimeline_MouseUp">
                            <Border Background="#252528" CornerRadius="4" Height="40" VerticalAlignment="Center"/>
                            <Border x:Name="VtTrimRegion" CornerRadius="4" Height="40" VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00897B" Offset="0"/>
                                        <GradientStop Color="#00695C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="VtHandleLeft" Width="12" Height="44" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Cursor="SizeWE" Background="#4DB6AC" CornerRadius="3,0,0,3">
                                <Border Width="2" Height="20" Background="White" CornerRadius="1"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="VtHandleRight" Width="12" Height="44" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Cursor="SizeWE" Background="#4DB6AC" CornerRadius="0,3,3,0">
                                <Border Width="2" Height="20" Background="White" CornerRadius="1"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="VtPlayhead" Width="2" Height="48" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="#4DB6AC" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="#4DB6AC"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VtStartLabel" Text="00:00:00" Foreground="#4DB6AC" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VtDurationLabel" Grid.Column="1" Text="" Foreground="#888" FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="VtEndLabel" Grid.Column="2" Text="00:00:00" Foreground="#4DB6AC" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 3: Bottom bar — trim inputs + export -->
                <Border Grid.Row="3" Background="#1A1A1E" Padding="12,8" BorderBrush="#2A2A2E" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Start -->
                            <ColumnDefinition Width="Auto"/>  <!-- Duration -->
                            <ColumnDefinition Width="*"/>     <!-- Spacer -->
                            <ColumnDefinition Width="Auto"/>  <!-- Export info -->
                            <ColumnDefinition Width="Auto"/>  <!-- Export button -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="Start" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVtStartTime" Text="00:00:00.000" Foreground="#CCC" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Set Start" Height="26" Padding="10,0" FontSize="10"
                                    Background="#252528" Foreground="#CCC" BorderBrush="#333" Cursor="Hand"
                                    Click="VideoSetTrimStart" Template="{StaticResource RoundedButton21}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="Duration" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVtDuration" Text="00:00:00.000" Foreground="#CCC" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Set End" Height="26" Padding="10,0" FontSize="10"
                                    Background="#252528" Foreground="#CCC" BorderBrush="#333" Cursor="Hand"
                                    Click="VideoSetTrimEnd" Template="{StaticResource RoundedButton21}"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtVideoExportInfo" Grid.Column="3" Text="" Foreground="#666" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Button Grid.Column="4" Content="Export Video" Width="160" Height="38"
                                FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#00897B"
                                Cursor="Hand" Click="VideoExport_Execute"
                                Template="{StaticResource RoundedButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ====================== PanelExtractAudio ====================== -->
        <Grid x:Name="PanelExtractAudio" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ExtractAudioSelectView" AllowDrop="True"
                          Drop="ExtractAudio_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Extract Audio" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Extract audio from one or more video files and save in your preferred format." FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select video files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#00BCD4" Cursor="Hand" Click="ExtractAudio_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop videos here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="ExtractAudioConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,8,24,20">

                    <!-- ========== Select Files Card ========== -->
                    <Border Background="#1A1D2E" CornerRadius="10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- header -->
                                <RowDefinition Height="Auto"/>  <!-- column headers -->
                                <RowDefinition Height="Auto"/>  <!-- file list -->
                                <RowDefinition Height="Auto"/>  <!-- footer -->
                            </Grid.RowDefinitions>

                            <!-- Header: Select Files + Add buttons -->
                            <Grid Margin="20,16,20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F4CB;" FontSize="16" Foreground="#4DB6AC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Select Files" Foreground="#EEE" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Add one or more video files to extract audio." Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+ Add Files" FontSize="12" Padding="14,7"
                                            Background="#252840" Foreground="#CCC" BorderBrush="#3A3D50" Cursor="Hand"
                                            Click="ExtractAudio_AddMoreBtn" Template="{StaticResource RoundedButton21}" Margin="0,0,8,0"/>
                                    <Button Content="&#x1F4C1; Add Folder" FontSize="12" Padding="14,7"
                                            Background="#252840" Foreground="#CCC" BorderBrush="#3A3D50" Cursor="Hand"
                                            Click="ExtractAudio_AddFolder" Template="{StaticResource RoundedButton21}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Column headers -->
                            <Grid Grid.Row="1" Margin="20,0,20,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>   <!-- # -->
                                    <ColumnDefinition Width="*"/>    <!-- File Name -->
                                    <ColumnDefinition Width="80"/>   <!-- Resolution -->
                                    <ColumnDefinition Width="90"/>   <!-- Duration -->
                                    <ColumnDefinition Width="80"/>   <!-- Size -->
                                    <ColumnDefinition Width="60"/>   <!-- Remove -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Foreground="#555" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="File Name" Foreground="#555" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Resolution" Foreground="#555" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Duration" Foreground="#555" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Size" Foreground="#555" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="Remove" Foreground="#555" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Grid>

                            <!-- File list -->
                            <ListBox x:Name="ExtractAudioList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                     MaxHeight="340" MinHeight="50"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="#252840"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="20,8,20,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>   <!-- checkbox + # -->
                                                <ColumnDefinition Width="*"/>    <!-- play + name + path -->
                                                <ColumnDefinition Width="80"/>   <!-- Resolution -->
                                                <ColumnDefinition Width="90"/>   <!-- Duration -->
                                                <ColumnDefinition Width="80"/>   <!-- Size -->
                                                <ColumnDefinition Width="60"/>   <!-- Remove -->
                                            </Grid.ColumnDefinitions>
                                            <!-- # -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Index}" Foreground="#555" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Play + Filename + Path -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="&#x25B6;" Width="36" Height="36" FontSize="14"
                                                        Background="#252840" Foreground="#4DB6AC" BorderThickness="0" Cursor="Hand"
                                                        Click="PreviewFile_Click" Tag="{Binding FilePath}"
                                                        Template="{StaticResource RoundedButton21}" Margin="0,0,10,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" Foreground="#CCC" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                                    <TextBlock Text="{Binding FilePath}" Foreground="#555" FontSize="9"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Resolution -->
                                            <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="#4DB6AC" FontSize="12"
                                                       VerticalAlignment="Center" TextAlignment="Center"/>
                                            <!-- Duration -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="&#x23F1;" Foreground="#888" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DurationText}" Foreground="#CCC" FontSize="12"/>
                                            </StackPanel>
                                            <!-- Size -->
                                            <TextBlock Grid.Column="4" Text="{Binding FileSize}" Foreground="#CCC" FontSize="12"
                                                       VerticalAlignment="Center" TextAlignment="Right"/>
                                            <!-- Remove -->
                                            <Button Grid.Column="5" Content="&#x1F5D1;" Width="28" Height="28" FontSize="14"
                                                    Background="Transparent" Foreground="#EF5350" BorderThickness="0" Cursor="Hand"
                                                    Click="ExtractAudio_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Footer: file count + total size -->
                            <Grid Grid.Row="3" Margin="20,8,20,14">
                                <TextBlock x:Name="TxtExtAudioFileCount" Text="0 files selected" Foreground="#888" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total size: " Foreground="#888" FontSize="12"/>
                                    <TextBlock x:Name="TxtExtAudioTotalSize" Text="0 B" Foreground="#4DB6AC" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ========== Output Settings + Save To (side by side) ========== -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Output Settings card -->
                        <Border Background="#1A1D2E" CornerRadius="10" Padding="20,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#x2699;" FontSize="16" Foreground="#4DB6AC" Margin="0,0,8,0"/>
                                    <TextBlock Text="Output Settings" Foreground="#EEE" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Format" Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CmbExtAudioFormat" Grid.Column="1" Width="130" Height="30" FontSize="12" SelectedIndex="0">
                                        <ComboBoxItem Content="MP3"/>
                                        <ComboBoxItem Content="WAV"/>
                                        <ComboBoxItem Content="AAC"/>
                                        <ComboBoxItem Content="FLAC"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkExtAudioThumb" Grid.Column="2" Content="Embed thumbnail as album art"
                                              Foreground="#CCC" FontSize="11" IsChecked="True" Cursor="Hand"
                                              VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Quality" Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CmbExtAudioQuality" Grid.Column="1" Width="190" Height="30" FontSize="12" SelectedIndex="0">
                                        <ComboBoxItem Content="320 kbps (High Quality)"/>
                                        <ComboBoxItem Content="256 kbps"/>
                                        <ComboBoxItem Content="192 kbps (Standard)"/>
                                        <ComboBoxItem Content="128 kbps (Small)"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Save To card -->
                        <Border Grid.Column="2" Background="#1A1D2E" CornerRadius="10" Padding="20,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#x1F4C1;" FontSize="16" Foreground="#7C4DFF" Margin="0,0,8,0"/>
                                    <TextBlock Text="Save To" Foreground="#EEE" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <RadioButton x:Name="RbExtAudioNew" Content="New files (choose output folder)"
                                             Foreground="#CCC" FontSize="12" IsChecked="True" Cursor="Hand"
                                             GroupName="ExtAudioSave" Margin="0,0,0,8"/>
                                <Grid Margin="20,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtExtAudioOutputFolder" Height="28" Padding="8,2" FontSize="11"
                                             Background="#252840" Foreground="#AAA" BorderBrush="#3A3D50" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse" FontSize="11" Padding="12,5"
                                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand"
                                            Click="ExtractAudio_BrowseFolder" Template="{StaticResource RoundedButton21}" Margin="6,0,0,0"/>
                                </Grid>
                                <RadioButton x:Name="RbExtAudioOverwrite" Content="Same folder as source (replace extension)"
                                             Foreground="#CCC" FontSize="12" Cursor="Hand" GroupName="ExtAudioSave"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Extract button -->
                    <Button Content="Extract Audio &#x2192;" Width="300" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#00897B"
                            HorizontalAlignment="Center" Cursor="Hand" Click="ExtractAudio_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== PanelTrimAudio ====================== -->
        <Grid x:Name="PanelTrimAudio" Grid.Row="1" Visibility="Collapsed">
            <!-- Select view: multi-file -->
            <Border x:Name="TrimAudioSelectView" AllowDrop="True"
                          Drop="TrimAudio_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Trim Audio" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Cut start and end of multiple audio files" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select audio files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#009688" Cursor="Hand" Click="TrimAudio_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop audio files here" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Config view: sidebar + main -->
            <Grid x:Name="TrimAudioConfigView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left sidebar: file list -->
                <Border Background="#1E1E22" BorderBrush="#333" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Margin="12,12,12,8">
                            <TextBlock x:Name="TxtTrimFileCount" Text="Files (0)" Foreground="#EEE" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="+ Add" FontSize="11" Padding="8,4" HorizontalAlignment="Right"
                                    Background="#333" Foreground="#4DB6AC" BorderBrush="#444" Cursor="Hand"
                                    Click="TrimAudio_AddMore" Template="{StaticResource RoundedButton21}"/>
                        </Grid>

                        <!-- File list -->
                        <ListBox x:Name="TrimAudioFileList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" Background="#1A3D3D" CornerRadius="6">
                                            <TextBlock Text="&#x266B;" FontSize="13" Foreground="#4DB6AC"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding FileName}" Foreground="#CCC" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            <TextBlock Text="{Binding Extra}" Foreground="#666" FontSize="9" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="#888" FontSize="11"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <Button Grid.Column="3" Content="&#x2715;" Width="18" Height="18" FontSize="9"
                                                Background="Transparent" Foreground="#666" BorderThickness="0" Cursor="Hand"
                                                Click="TrimAudio_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Total duration -->
                        <Border Grid.Row="2" Background="#1A1A1E" Padding="12,10" BorderBrush="#333" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock Text="Total Duration" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="TxtTrimTotalDuration" Text="00:00" Foreground="#EEE" FontSize="14"
                                           FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right main area -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Trim settings bar -->
                        <RowDefinition Height="*"/>      <!-- Waveform rows -->
                        <RowDefinition Height="Auto"/>   <!-- Bottom bar -->
                    </Grid.RowDefinitions>

                    <!-- Trim settings bar -->
                    <Border Background="#252528" Padding="16,10" BorderBrush="#333" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Trim Settings" Foreground="#EEE" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="Cut Start" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtGlobalTrimStart" Width="85" Height="26" Padding="6,2" FontSize="11"
                                         Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444" Text="00:00.000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="Cut End" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtGlobalTrimEnd" Width="85" Height="26" Padding="6,2" FontSize="11"
                                         Background="#1A1A1E" Foreground="#EEE" BorderBrush="#444" Text="00:01.000"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Apply to All" FontSize="11" Padding="10,5"
                                    Background="#333" Foreground="#4DB6AC" BorderBrush="#444" Cursor="Hand"
                                    Click="TrimAudio_ApplyToAll" Template="{StaticResource RoundedButton21}"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="5" Content="Reset" FontSize="11" Padding="10,5"
                                    Background="#333" Foreground="#888" BorderBrush="#444" Cursor="Hand"
                                    Click="TrimAudio_Reset" Template="{StaticResource RoundedButton21}"/>
                        </Grid>
                    </Border>

                    <!-- Waveform rows (built programmatically) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TrimWaveformPanel"/>
                    </ScrollViewer>

                    <!-- Bottom bar -->
                    <Border Grid.Row="2" Background="#1E1E22" Padding="16,10" BorderBrush="#333" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="Format" Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbTrimAudioFormat" Width="100" Height="28" FontSize="12" SelectedIndex="0">
                                    <ComboBoxItem Content="Original"/>
                                    <ComboBoxItem Content="MP3"/>
                                    <ComboBoxItem Content="WAV"/>
                                    <ComboBoxItem Content="FLAC"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Output Folder" Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtTrimOutputFolder" Width="220" Height="28" Padding="6,2" FontSize="11"
                                         Background="#1A1A1E" Foreground="#AAA" BorderBrush="#444" IsReadOnly="True"/>
                                <Button Content="&#x1F4C1;" FontSize="13" Width="30" Height="28"
                                        Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand"
                                        Click="TrimAudio_BrowseFolder" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="&#x2702; Trim All" Width="160" Height="40"
                                    FontSize="15" FontWeight="SemiBold" Foreground="White" Background="#009688"
                                    Cursor="Hand" Click="TrimAudio_Execute"
                                    Template="{StaticResource RoundedButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ====================== PanelYouTubeDl ====================== -->
        <Grid x:Name="PanelYouTubeDl" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="YtSelectView" Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="YouTube Download" FontSize="28" FontWeight="Bold" Foreground="#EEE"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Download video or audio from YouTube" FontSize="14" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <!-- URL input -->
                    <Grid Width="500" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtYtUrl" Height="44" Padding="14,10" FontSize="14"
                                 Background="#252528" Foreground="#EEE" BorderBrush="#444" BorderThickness="2"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="#252528"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1" Content="Fetch &#x2192;" Width="90" Height="44"
                                FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#FF0000"
                                Cursor="Hand" Click="Yt_Fetch" Margin="8,0,0,0"
                                Template="{StaticResource RoundedButton}"/>
                    </Grid>
                    <TextBlock Text="Paste a YouTube URL (video or playlist)" FontSize="12" Foreground="#666"
                               HorizontalAlignment="Center"/>
                    <!-- Loading spinner (shown while fetching) -->
                    <StackPanel x:Name="YtSpinner" Visibility="Collapsed" Margin="0,30,0,0" HorizontalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" BorderThickness="3"
                                RenderTransformOrigin="0.5,0.5" x:Name="YtSpinnerBorder">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="0.7"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.RenderTransform>
                                <RotateTransform x:Name="YtSpinnerRotate" Angle="0"/>
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock x:Name="TxtYtSpinner" Text="Fetching video info..." Foreground="#888" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Config state -->
            <Grid x:Name="YtConfigView" Visibility="Collapsed" Margin="16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header with info + controls -->
                    <RowDefinition Height="*"/>      <!-- Video list -->
                    <RowDefinition Height="Auto"/>   <!-- Download controls -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TxtYtTitle" Text="" Foreground="#EEE" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/>
                        <TextBlock x:Name="TxtYtDetail" Text="" Foreground="#888" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Select All" Width="80" Height="28" FontSize="11"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand"
                            Click="Yt_SelectAll" Margin="8,0,4,0"/>
                    <Button Grid.Column="2" Content="Deselect All" Width="85" Height="28" FontSize="11"
                            Background="#333" Foreground="#CCC" BorderBrush="#444" Cursor="Hand"
                            Click="Yt_DeselectAll"/>
                </Grid>

                <!-- Video list with thumbnails -->
                <ListBox x:Name="YtVideoList" Grid.Row="1" Background="#1A1A1E" BorderBrush="#333" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#252528"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- Checkbox -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Thumbnail -->
                                    <ColumnDefinition Width="*"/>     <!-- Title + duration -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Status -->
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                          Cursor="Hand" Margin="0,0,8,0"/>
                                <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="120" Height="68"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       Margin="0,0,10,0">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,120,68" RadiusX="4" RadiusY="4"/>
                                    </Image.Clip>
                                </Image>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="#CCC" FontSize="13"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding Duration}" Foreground="#666" FontSize="11" Margin="0,2,0,0"/>
                                    <!-- Per-video progress bar -->
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="#42A5F5" Background="#333" BorderThickness="0"
                                                 Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Download controls -->
                <Grid Grid.Row="2" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- Mode selector -->
                        <ColumnDefinition Width="Auto"/>   <!-- Quality -->
                        <ColumnDefinition Width="*"/>      <!-- Progress info -->
                        <ColumnDefinition Width="Auto"/>   <!-- Stop button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Download button -->
                    </Grid.ColumnDefinitions>

                    <!-- Mode -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbYtVideo" Content="Video" Foreground="#CCC" FontSize="12"
                                     IsChecked="True" GroupName="YtMode" Margin="0,0,12,0" Cursor="Hand"
                                     Checked="YtMode_Changed"/>
                        <RadioButton x:Name="RbYtAudio" Content="MP3" Foreground="#CCC" FontSize="12"
                                     GroupName="YtMode" Cursor="Hand" Checked="YtMode_Changed"/>
                    </StackPanel>

                    <!-- Quality (video only) -->
                    <StackPanel x:Name="YtVideoOptions" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <ComboBox x:Name="CmbYtQuality" Width="80" Height="28" FontSize="11" SelectedIndex="0">
                            <ComboBoxItem Content="Best"/>
                            <ComboBoxItem Content="720p"/>
                            <ComboBoxItem Content="480p"/>
                            <ComboBoxItem Content="360p"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Audio options (hidden by default) -->
                    <CheckBox x:Name="ChkYtEmbedThumb" Grid.Column="1" Content="Embed thumbnail"
                              Foreground="#CCC" FontSize="11" IsChecked="True" Cursor="Hand"
                              Visibility="Collapsed" VerticalAlignment="Center" Margin="16,0,0,0"/>

                    <!-- Progress info -->
                    <TextBlock x:Name="TxtYtOverallProgress" Grid.Column="2" Text="" Foreground="#888" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <!-- Stop button -->
                    <Button x:Name="BtnYtStop" Grid.Column="3" Content="Stop" Width="70" Height="38"
                            FontSize="13" Background="#EF5350" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="Yt_Stop" Visibility="Collapsed" Margin="0,0,8,0"
                            Template="{StaticResource RoundedButton21}"/>

                    <!-- Download button -->
                    <Button x:Name="BtnYtDownload" Grid.Column="4" Content="Download &#x2192;" Width="140" Height="42"
                            FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#FF0000"
                            Cursor="Hand" Click="Yt_Download"
                            Template="{StaticResource RoundedButton}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!--  Processing Overlay (shared, Grid.Row="1")                       -->
        <!-- ================================================================ -->
        <Border x:Name="ProcessingOverlay" Grid.Row="1" Visibility="Collapsed" Background="#E61A1A1E"
                IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtProcessing" Text="Processing..." FontSize="18" Foreground="#CCC"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar x:Name="MainProgress" Width="350" Height="6" Margin="0,0,0,8"
                             Foreground="#42A5F5" Background="#333" BorderThickness="0"
                             Minimum="0" Maximum="100"/>
                <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="13" Foreground="#888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================================================================ -->
        <!--  Complete Overlay (shared, Grid.Row="1")                         -->
        <!-- ================================================================ -->
        <Border x:Name="CompleteOverlay" Grid.Row="1" Visibility="Collapsed" Background="#E61A1A1E"
                IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Green checkmark circle -->
                <Border Width="80" Height="80" CornerRadius="40" Background="#4CAF50" Margin="0,0,0,16">
                    <TextBlock Text="&#x2713;" FontSize="36" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtCompleteMsg" FontSize="20" Foreground="#EEE" HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                <TextBlock x:Name="TxtCompleteDetail" FontSize="13" Foreground="#888" HorizontalAlignment="Center"
                           Margin="0,6,0,20"/>
                <Button x:Name="BtnCompleteOpen" Content="Open File" Width="200" Height="42"
                        FontSize="14" FontWeight="SemiBold" Background="#4CAF50" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Complete_OpenFile"
                        Margin="0,0,0,8" Template="{StaticResource RoundedButton21}"/>
                <Button x:Name="BtnCompleteFolder" Content="Open Folder" Width="200" Height="42"
                        FontSize="14" Background="#333" Foreground="#CCC" BorderThickness="0"
                        Cursor="Hand" Click="Complete_OpenFolder"
                        Margin="0,0,0,12" Template="{StaticResource RoundedButton21}"/>
                <TextBlock Text="Start Over" Foreground="#888" FontSize="13" Cursor="Hand"
                           HorizontalAlignment="Center" TextDecorations="Underline"
                           MouseLeftButtonDown="Complete_StartOver"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
