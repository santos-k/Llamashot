<Window x:Class="Llamashot.Views.FileToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="Llamashot - File Tools"
        Width="850" Height="680"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="720" MinHeight="520"
        Background="{DynamicResource WindowGradientBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- File list item template (with index, name, extra, size, remove button) -->
        <DataTemplate x:Key="FileListItemTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Width="24" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                           VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="X" Width="22" Height="22" FontSize="11"
                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                        Tag="{Binding FilePath}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Image file list item template (with thumbnail) -->
        <DataTemplate x:Key="ImageFileListItemTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Width="24" VerticalAlignment="Center"/>
                <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
                <Button Grid.Column="4" Content="X" Width="22" Height="22" FontSize="11"
                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                        Tag="{Binding FilePath}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!--  Row 0: Header                                                   -->
        <!-- ================================================================ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}" Padding="16,10"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Button x:Name="BtnBack" Content="&#x2190; Back" HorizontalAlignment="Left" Visibility="Collapsed"
                        Click="GoBack_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Padding="8,4"/>
                <TextBlock x:Name="TxtToolTitle" Text="File Tools" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="BtnThemeToggle" HorizontalAlignment="Right" Content="&#x1F319;"
                        ToolTip="Toggle light / dark theme" Click="ThemeToggle_Click"
                        Background="Transparent" BorderThickness="0" FontSize="18" Cursor="Hand" Padding="8,2"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!--  Row 1: Content                                                  -->
        <!-- ================================================================ -->

        <!-- Home Panel: search + card grid -->
        <Grid x:Name="HomePanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Search + Sort bar -->
            <Grid Margin="24,12,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border BorderThickness="1.5" CornerRadius="18" Height="38">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="TxtToolSearch" FontSize="13" Padding="14,6" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             VerticalContentAlignment="Center" TextChanged="ToolSearch_Changed"/>
                </Border>
                <TextBlock Text="&#x1F50D; Search tools..." Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"
                           x:Name="TxtSearchPlaceholder"/>
                <ComboBox x:Name="CmbToolSort" Grid.Column="1" Width="140" Height="38" FontSize="12"
                          SelectedIndex="0" Margin="10,0,0,0" SelectionChanged="ToolSort_Changed">
                    <ComboBoxItem Content="Group by category"/>
                    <ComboBoxItem Content="Sort A-Z"/>
                    <ComboBoxItem Content="Sort Z-A"/>
                </ComboBox>
            </Grid>
            <!-- Category filter chips -->
            <ItemsControl x:Name="CategoryChips" Grid.Row="1" Margin="24,14,24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <!-- Card container -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CardPanel" Margin="20,8,20,16"/>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 1. PanelMergePdf ====================== -->
        <Grid x:Name="PanelMergePdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="MergeSelectView" AllowDrop="True"
                          Drop="MergePdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Merge PDF files" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Combine PDFs in the order you want" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button x:Name="BtnMergeSelect" Content="Select PDF files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="MergePdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop PDFs here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="MergeConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="{DynamicResource AccentBrush}" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="MergePdf_AddMore"/>
                    <ListBox x:Name="MergePdfList" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                             BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" MaxHeight="280" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="{DynamicResource AccentBrush}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="4" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="5" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="MergePdf_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Merge PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center" Cursor="Hand" Click="MergePdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 2. PanelSplitPdf ====================== -->
        <Grid x:Name="PanelSplitPdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="SplitSelectView" AllowDrop="True"
                          Drop="SplitPdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Split PDF" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Extract specific pages from a PDF" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#FF7043" Cursor="Hand" Click="SplitPdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="SplitConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtSplitFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSplitInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,20"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="From page:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSplitFrom" Grid.Column="1" Height="28" Padding="6,4" FontSize="12"
                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="1"/>
                        <TextBlock Text="To page:" Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="TxtSplitTo" Grid.Column="3" Height="28" Padding="6,4" FontSize="12"
                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"/>
                    </Grid>
                    <Button Content="Split PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#FF7043"
                            HorizontalAlignment="Center" Cursor="Hand" Click="SplitPdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 3. PanelCompressPdf ====================== -->
        <Grid x:Name="PanelCompressPdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CompressPdfSelectView" AllowDrop="True"
                          Drop="CompressPdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Compress PDF" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Reduce the size of your PDF" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="CompressPdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="CompressPdfConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtCompressPdfFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtCompressPdfInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,20"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldPdfQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="80"
                                VerticalAlignment="Center" ValueChanged="CompressPdf_QualityChanged"/>
                        <TextBlock x:Name="TxtPdfQualityVal" Grid.Column="2" Text="80" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Compress PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center" Cursor="Hand" Click="CompressPdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 4. PanelPdfToImages ====================== -->
        <Grid x:Name="PanelPdfToImages" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="PdfToImgSelectView" AllowDrop="True"
                          Drop="PdfToImg_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="PDF to Images" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Convert each PDF page to an image" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="PdfToImg_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="PdfToImgConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtPdfToImgFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtPdfToImgInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,20"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Format:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbPdfImgFormat" Grid.Column="1" Width="70" Height="28" FontSize="12" SelectedIndex="0">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                        </ComboBox>
                        <TextBlock Text="DPI:" Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="CmbPdfImgDpi" Grid.Column="3" Width="70" Height="28" FontSize="12" SelectedIndex="1">
                            <ComboBoxItem Content="72"/>
                            <ComboBoxItem Content="150"/>
                            <ComboBoxItem Content="300"/>
                        </ComboBox>
                    </Grid>
                    <Button Content="Convert to Images &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center" Cursor="Hand" Click="PdfToImg_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 5. PanelImagesToPdf ====================== -->
        <Grid x:Name="PanelImagesToPdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ImgToPdfSelectView" AllowDrop="True"
                          Drop="ImgToPdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Images to PDF" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Combine your images into a single PDF" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#E91E63" Cursor="Hand" Click="ImgToPdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop images here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="ImgToPdfConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="{DynamicResource AccentBrush}" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="ImgToPdf_AddMore"/>
                    <ListBox x:Name="ImgToPdfList" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                             BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" MaxHeight="280" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="4" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="ImgToPdf_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Create PDF &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#E91E63"
                            HorizontalAlignment="Center" Cursor="Hand" Click="ImgToPdf_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 6. PanelRotatePdf ====================== -->
        <Grid x:Name="PanelRotatePdf" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="RotatePdfSelectView" AllowDrop="True"
                          Drop="RotatePdf_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Rotate PDF" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Rotate all pages of your PDF" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#FFA726" Cursor="Hand" Click="RotatePdf_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="RotatePdfConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtRotatePdfFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtRotatePdfInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Margin="0,0,0,12" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="RotatePdfPreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="RpRotateTransform" Angle="0"/>
                        </Image.RenderTransform>
                    </Image>
                </Border>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="&#x21BA; 90&#x00B0; CW" Width="100" Height="36" Margin="0,0,8,6" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotatePdf_CW"
                            Template="{StaticResource RoundedButton21}"/>
                    <Button Content="&#x21BB; 90&#x00B0; CCW" Width="100" Height="36" Margin="0,0,8,6" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotatePdf_CCW"
                            Template="{StaticResource RoundedButton21}"/>
                    <Button Content="180&#x00B0;" Width="70" Height="36" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotatePdf_180"
                            Template="{StaticResource RoundedButton21}"/>
                </WrapPanel>
                <Button Grid.Row="3" Content="Save Rotated PDF &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                        FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#FFA726"
                        HorizontalAlignment="Center" Cursor="Hand" Click="RotatePdf_Execute"
                        Template="{StaticResource RoundedButton}"/>
            </Grid>
        </Grid>

        <!-- ====================== 7. PanelWatermark ====================== -->
        <Grid x:Name="PanelWatermark" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="WatermarkSelectView" AllowDrop="True"
                          Drop="Watermark_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Watermark PDF" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Add a text watermark to every page" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#7E57C2" Cursor="Hand" Click="Watermark_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="WatermarkConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtWatermarkFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Watermark text:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtWatermarkText" Height="28" Padding="6,4" FontSize="12"
                             Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Margin="0,0,0,16"
                             Text="CONFIDENTIAL"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldWatermarkOpacity" Grid.Column="1" Minimum="10" Maximum="100" Value="30"
                                VerticalAlignment="Center" ValueChanged="Watermark_OpacityChanged"/>
                        <TextBlock x:Name="TxtWatermarkOpacityVal" Grid.Column="2" Text="30%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Width="40" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font size:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldWatermarkFontSize" Grid.Column="1" Minimum="12" Maximum="96" Value="48"
                                VerticalAlignment="Center" ValueChanged="Watermark_FontSizeChanged"/>
                        <TextBlock x:Name="TxtWatermarkFontSizeVal" Grid.Column="2" Text="48" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Add Watermark &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#7E57C2"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Watermark_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 8. PanelPageNumbers ====================== -->
        <Grid x:Name="PanelPageNumbers" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="PageNumSelectView" AllowDrop="True"
                          Drop="PageNum_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Page Numbers" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Add page numbers to your PDF" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#5C6BC0" Cursor="Hand" Click="PageNum_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="PageNumConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtPageNumFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Position:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbPageNumPos" Grid.Column="1" Width="150" Height="28" FontSize="12" SelectedIndex="0">
                            <ComboBoxItem Content="Bottom Center"/>
                            <ComboBoxItem Content="Bottom Right"/>
                            <ComboBoxItem Content="Top Center"/>
                            <ComboBoxItem Content="Top Right"/>
                        </ComboBox>
                    </Grid>
                    <Button Content="Add Page Numbers &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#5C6BC0"
                            HorizontalAlignment="Center" Cursor="Hand" Click="PageNum_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 9. PanelExtractPages ====================== -->
        <Grid x:Name="PanelExtractPages" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ExtractSelectView" AllowDrop="True"
                          Drop="Extract_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Extract Pages" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Pick specific pages from a PDF" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select PDF file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#FF8A65" Cursor="Hand" Click="Extract_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="ExtractConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtExtractFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtExtractInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Click pages to select/deselect. Selected pages will be extracted." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Page thumbnail grid -->
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <WrapPanel x:Name="ExtractPageGrid" HorizontalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Selection info -->
                    <TextBlock x:Name="TxtExtractSelection" Text="No pages selected" Foreground="{DynamicResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Button Content="Extract Selected Pages &#x2192;" Width="300" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#FF8A65"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Extract_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 10. PanelInsertPages ====================== -->
        <Grid x:Name="PanelInsertPages" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="InsertSelectView" AllowDrop="True"
                          Drop="Insert_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Insert Pages" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Add new pages to an existing PDF" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select base PDF" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#A1887F" Cursor="Hand" Click="Insert_SelectBase"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a PDF here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="InsertConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtInsertBaseName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtInsertBaseInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Click a &#x2295; button between pages to set insertion point, then add images." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Page flow with insertion points -->
                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <WrapPanel x:Name="InsertPageGrid" HorizontalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Insertion point indicator -->
                    <TextBlock x:Name="TxtInsertPosition" Text="Insert position: beginning" Foreground="{DynamicResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Image drop zone -->
                    <TextBlock Text="Images to insert:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="2" CornerRadius="6"
                            Padding="14" Cursor="Hand" Margin="0,0,0,8" AllowDrop="True"
                            Drop="Insert_ImageDrop" DragOver="Generic_DragOver"
                            MouseLeftButtonDown="Insert_BrowseImages">
                        <TextBlock Text="Drop images here or click to browse" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <ListBox x:Name="InsertImageList" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                             BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" MaxHeight="120" MinHeight="30"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="Insert_RemoveImage" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="Insert Pages &#x2192;" Width="300" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#A1887F"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Insert_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 11. PanelCompressImage ====================== -->
        <Grid x:Name="PanelCompressImage" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CompressImgSelectView" AllowDrop="True"
                          Drop="CompressImg_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Compress Images" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Reduce image file size while maintaining quality" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#26C6DA" Cursor="Hand" Click="CompressImg_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop images here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="CompressImgConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="{DynamicResource AccentBrush}" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="CompressImg_AddMore"/>
                    <ListBox x:Name="CompressImgList" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                             BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" MaxHeight="200" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="4" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="CompressImg_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Mode toggle: by quality vs by target size -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbImgByQuality" Content="By quality" GroupName="ImgCompressMode" IsChecked="True"
                                     Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalContentAlignment="Center"
                                     Margin="0,0,20,0" Checked="CompressImg_ModeChanged"/>
                        <RadioButton x:Name="RbImgByTarget" Content="By target size" GroupName="ImgCompressMode"
                                     Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalContentAlignment="Center"
                                     Checked="CompressImg_ModeChanged"/>
                    </StackPanel>
                    <Grid x:Name="ImgQualityRow" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldImgQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="80"
                                VerticalAlignment="Center" ValueChanged="CompressImg_QualityChanged"/>
                        <TextBlock x:Name="TxtImgQualityVal" Grid.Column="2" Text="80" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid x:Name="ImgMaxDimRow" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max dimension:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtImgMaxDim" Grid.Column="1" Height="28" Padding="6,4" FontSize="12"
                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"/>
                        <TextBlock Grid.Column="2" Text="px (empty = no limit)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <StackPanel x:Name="ImgTargetRow" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Each image is brought under this size — quality is lowered first, then resolution if needed."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target size:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtImgTarget" Grid.Column="1" Text="1" Height="28" Padding="6,4" FontSize="12"
                                     Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"/>
                            <ComboBox x:Name="CboImgTargetUnit" Grid.Column="2" Width="72" Height="28" FontSize="12"
                                      VerticalContentAlignment="Center" Margin="8,0,0,0">
                                <ComboBoxItem Content="KB"/>
                                <ComboBoxItem Content="MB" IsSelected="True"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <Button Content="Compress All &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#26C6DA"
                            HorizontalAlignment="Center" Cursor="Hand" Click="CompressImg_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 12. PanelResizeImage ====================== -->
        <Grid x:Name="PanelResizeImage" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ResizeSelectView" AllowDrop="True"
                          Drop="Resize_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Resize Image" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Change the dimensions of your image" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#26A69A" Cursor="Hand" Click="Resize_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ResizeConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtResizeFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtResizeInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="ResizePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Row="2">
                    <!-- Resize mode selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbResizePixels" Content="Pixels" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                     IsChecked="True" GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizePercent" Content="Percentage" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                     GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizeInches" Content="Inches" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                     GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizeCm" Content="cm" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                     GroupName="ResizeUnit" Margin="0,0,16,0" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                        <RadioButton x:Name="RbResizeMm" Content="mm" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                     GroupName="ResizeUnit" Cursor="Hand"
                                     Checked="ResizeUnit_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtResizeWLabel" Text="Width:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtResizeW" Grid.Column="1" Height="28" Padding="6,4" FontSize="12"
                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" TextChanged="ResizeW_Changed"/>
                        <TextBlock x:Name="TxtResizeHLabel" Text="Height:" Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="TxtResizeH" Grid.Column="3" Height="28" Padding="6,4" FontSize="12"
                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" TextChanged="ResizeH_Changed"/>
                        <TextBlock x:Name="TxtResizeUnit" Grid.Column="4" Text="px" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <!-- DPI input for physical units -->
                    <Grid x:Name="ResizeDpiRow" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DPI:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtResizeDpi" Height="28" Padding="6,4" FontSize="12"
                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="96" Grid.Column="1"/>
                        <TextBlock Text="(dots per inch)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Grid.Column="2"/>
                    </Grid>
                    <CheckBox x:Name="ChkResizeAspect" Content="Maintain aspect ratio" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                              IsChecked="True" Margin="0,0,0,4" Cursor="Hand"/>
                    <!-- Output pixel size preview -->
                    <TextBlock x:Name="TxtResizeOutput" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,8"/>
                    <Button Content="Resize &amp; Save &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#26A69A"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Resize_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ====================== 13. PanelCropImage ====================== -->
        <Grid x:Name="PanelCropImage" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CropSelectView" AllowDrop="True"
                          Drop="Crop_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Crop Image" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Crop your image to a specific area" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="Crop_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="CropConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtCropFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtCropImgSize" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Margin="0,0,0,8" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Grid x:Name="CropContainer">
                        <Image x:Name="CropPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="CropCanvas" Background="Transparent"
                                MouseLeftButtonDown="CropCanvas_MouseDown"
                                MouseMove="CropCanvas_MouseMove"
                                MouseLeftButtonUp="CropCanvas_MouseUp"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtCropInfo" Text="Draw a crop area on the image" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkCropAspect" Content="Lock ratio" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button x:Name="BtnCropSmart" Content="&#x2728; Smart crop" Height="26" Padding="10,0" FontSize="11" Background="{DynamicResource AccentBrush}" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Click="CropSmart_Click" Margin="0,0,8,0" ToolTip="AI-detect the subject and set the crop to it"/>
                        <Button Content="Reset" Width="60" Height="26" FontSize="11" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="Crop_Reset"/>
                    </StackPanel>
                </Grid>
                <Button Grid.Row="3" Content="Crop &amp; Save &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                        FontSize="16" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center" Cursor="Hand" Click="Crop_Execute"
                        Template="{StaticResource RoundedButton}"/>
            </Grid>
        </Grid>

        <!-- ====================== 14. PanelRotateFlip ====================== -->
        <Grid x:Name="PanelRotateFlip" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="RotateFlipSelectView" AllowDrop="True"
                          Drop="RotateFlip_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Rotate &amp; Flip" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Rotate or flip your image" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#AB47BC" Cursor="Hand" Click="RotateFlip_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="RotateFlipConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtRotateFlipFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Margin="0,0,0,12" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="RotateFlipPreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RfFlipTransform" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="RfRotateTransform" Angle="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Border>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="&#x21BA; 90&#x00B0;" Width="80" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotateFlip_CW"/>
                    <Button Content="&#x21BB; 90&#x00B0;" Width="80" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotateFlip_CCW"/>
                    <Button Content="180&#x00B0;" Width="60" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotateFlip_180"/>
                    <Button Content="&#x2194; Flip H" Width="80" Height="36" Margin="0,0,10,6" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotateFlip_FlipH"/>
                    <Button Content="&#x2195; Flip V" Width="80" Height="36" Margin="0,0,0,6" FontSize="13"
                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand" Click="RotateFlip_FlipV"/>
                </WrapPanel>
                <Button Grid.Row="3" Content="Save &#x2192;" Width="280" Height="50" Margin="0,4,0,12"
                        FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#AB47BC"
                        HorizontalAlignment="Center" Cursor="Hand" Click="RotateFlip_Execute"
                        Template="{StaticResource RoundedButton}"/>
            </Grid>
        </Grid>

        <!-- ====================== 15. PanelConvertFormat ====================== -->
        <Grid x:Name="PanelConvertFormat" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ConvertSelectView" AllowDrop="True"
                          Drop="Convert_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Convert Image" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Convert your image to a different format" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select image file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#EC407A" Cursor="Hand" Click="Convert_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ConvertConfigView" Visibility="Collapsed" Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtConvertFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtConvertInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <Image x:Name="ConvertPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target format:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbConvertFormat" Grid.Column="1" Width="100" Height="28" FontSize="12" SelectedIndex="0"
                                  SelectionChanged="Convert_FormatChanged">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                            <ComboBoxItem Content="BMP"/>
                            <ComboBoxItem Content="GIF"/>
                            <ComboBoxItem Content="TIFF"/>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="ConvertQualityPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JPEG quality:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldConvertQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="90"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtConvertQualityVal" Grid.Column="2" Text="90" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Convert &#x2192;" Width="280" Height="50" Margin="0,8,0,12"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#EC407A"
                            HorizontalAlignment="Center" Cursor="Hand" Click="Convert_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </Grid>
        </Grid>


        <!-- ====================== PanelImageEditor ====================== -->
        <Grid x:Name="PanelImageEditor" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ImgEditorSelectView" AllowDrop="True"
                    Drop="ImgEditor_SelectDrop" DragOver="Generic_DragOver" Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Image Editor" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Open an image to edit &#x2014; crop, resize, rotate, adjust &amp; more"
                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Open Image" Width="280" Height="50" FontSize="16" FontWeight="SemiBold"
                            Foreground="White" Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="ImgEditor_SelectFile"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop an image here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ImgEditorConfigView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Background="{DynamicResource SurfaceBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Width="34" Height="34" CornerRadius="7" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="&#x2B1C;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Image Tool" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Edit single image with ease" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="TxtIeFileName" Text="image.jpg" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtIeFileInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Button Content="&#x21B6; Undo" Padding="8,5" FontSize="11" Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="IeUndo_Click" ToolTip="Ctrl+Z"/>
                            <Button Content="&#x21B7; Redo" Padding="8,5" FontSize="11" Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="IeRedo_Click" ToolTip="Ctrl+Y"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Reset All" Padding="14,6" FontSize="12"
                                Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                Cursor="Hand" Click="IeReset_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="4" Content="Save Image" Padding="16,6" FontSize="12" FontWeight="SemiBold"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="IeSave_Click" Template="{StaticResource RoundedButton21}"/>
                    </Grid>
                </Border>
                <!-- Main -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="6,12,6,8">
                                <TextBlock Text="TOOLS" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,12"/>
                                <Button x:Name="BtnIeTool_crop" Tag="crop" Click="IeToolSelect_Click" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2702;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Crop" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Crop image to desired area" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_resize" Tag="resize" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2922;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Resize" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Change image dimensions" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_rotateflip" Tag="rotateflip" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x21BA;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Rotate &amp; Flip" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Rotate or flip image" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_adjust" Tag="adjust" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2263;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Adjust" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Brightness, contrast, etc." FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_filters" Tag="filters" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2666;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Filters" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Apply beautiful filters" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_watermark" Tag="watermark" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x00A9;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Watermark" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Add text or image watermark" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_compress" Tag="compress" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2B07;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Compress" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Reduce image file size" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_convert" Tag="convert" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x21C4;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Convert" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Convert to other formats" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnIeTool_background" Tag="background" Click="IeToolSelect_Click" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,1" Template="{StaticResource PeToolButton}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#x2728;" FontSize="14" VerticalAlignment="Center" Width="22"/><TextBlock Text="Background" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="AI remove / blur / replace background" FontSize="9" Opacity="0.6" Margin="22,1,0,0"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- Canvas with scrollviewer -->
                    <Grid Grid.Column="1" Background="{DynamicResource WindowBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{DynamicResource SurfaceBrush}" Padding="8,6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="-" Width="28" Height="28" FontSize="16" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="IeZoom_Out" ToolTip="Zoom out"/>
                                <TextBlock x:Name="TxtIeZoom" Text="Fit" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,10,0" Width="40" TextAlignment="Center"/>
                                <Button Content="+" Width="28" Height="28" FontSize="16" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="IeZoom_In" ToolTip="Zoom in"/>
                                <Border Width="1" Background="{DynamicResource SurfaceAltBrush}" Margin="12,4"/>
                                <Button Content="&#x2922;" Width="28" Height="28" FontSize="14" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="IeZoom_Fit" ToolTip="Fit to window"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer x:Name="IeScrollViewer" Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource WindowBrush}"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="IeZoomTransform" ScaleX="1" ScaleY="1"/>
                                </Grid.LayoutTransform>
                                <Image x:Name="IePreviewImage" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform x:Name="IeRotateTransform" Angle="0"/>
                                            <ScaleTransform x:Name="IeFlipTransform" ScaleX="1" ScaleY="1"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <Canvas x:Name="IeCanvas" ClipToBounds="True" Background="Transparent"
                                        MouseLeftButtonDown="IeCanvas_MouseDown"
                                        MouseMove="IeCanvas_MouseMove"
                                        MouseLeftButtonUp="IeCanvas_MouseUp"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <!-- Right panel -->
                    <Border Grid.Column="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- CROP -->
                                <StackPanel x:Name="IeSecCrop" Margin="16,16">
                                    <TextBlock Text="CROP" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Ratio" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbIeCropRatio" Height="28" FontSize="11" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="IeCropRatio_Changed">
                                        <ComboBoxItem Content="Custom"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="3:2"/>
                                    </ComboBox>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="W" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="TxtIeCropW" Height="28" Padding="6,3" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="H" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="TxtIeCropH" Height="28" Padding="6,3" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="X" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="TxtIeCropX" Height="28" Padding="6,3" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Y" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="TxtIeCropY" Height="28" Padding="6,3" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="0"/></StackPanel>
                                    </Grid>
                                    <Button Content="Apply Crop" Padding="0,8" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="IeCrop_Apply" HorizontalContentAlignment="Center" Template="{StaticResource RoundedButton21}"/>
                                </StackPanel>
                                <!-- RESIZE -->
                                <StackPanel x:Name="IeSecResize" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="RESIZE" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Width" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="TxtIeResizeW" Height="28" Padding="6,3" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" TextChanged="IeResizeW_Changed"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Height" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="TxtIeResizeH" Height="28" Padding="6,3" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" TextChanged="IeResizeH_Changed"/></StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="ChkIeResizeLock" Content="Lock aspect ratio" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" IsChecked="True" Margin="0,0,0,8"/>
                                    <TextBlock Text="Percentage" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeResizePct" Minimum="10" Maximum="400" Value="100" ValueChanged="IeResizePct_Changed"/>
                                        <TextBlock x:Name="TxtIeResizePct" Grid.Column="1" Text="100%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
                                    </Grid>
                                    <Button Content="Apply Resize" Padding="0,8" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="IeResize_Apply" HorizontalContentAlignment="Center" Template="{StaticResource RoundedButton21}"/>
                                </StackPanel>
                                <!-- ROTATE & FLIP -->
                                <StackPanel x:Name="IeSecRotateFlip" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="ROTATE &amp; FLIP" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Content="&#x21BA; Rotate Left" Padding="0,8" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeRotate_Left" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="&#x21BB; Rotate Right" Padding="0,8" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeRotate_Right"/>
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Content="&#x21C6; Flip H" Padding="0,8" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFlip_H" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="&#x21C5; Flip V" Padding="0,8" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFlip_V"/>
                                    </Grid>
                                </StackPanel>
                                <!-- ADJUST -->
                                <StackPanel x:Name="IeSecAdjust" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="ADJUST" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Brightness" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeBrightness" Minimum="-100" Maximum="100" Value="0" ValueChanged="IeAdjust_Changed"/>
                                        <TextBlock x:Name="TxtIeBrightVal" Grid.Column="1" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Contrast" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeContrast" Minimum="-100" Maximum="100" Value="0" ValueChanged="IeAdjust_Changed"/>
                                        <TextBlock x:Name="TxtIeContrastVal" Grid.Column="1" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Saturation" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeSaturation" Minimum="-100" Maximum="100" Value="0" ValueChanged="IeAdjust_Changed"/>
                                        <TextBlock x:Name="TxtIeSatVal" Grid.Column="1" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Exposure" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeExposure" Minimum="-100" Maximum="100" Value="0" ValueChanged="IeAdjust_Changed"/>
                                        <TextBlock x:Name="TxtIeExposureVal" Grid.Column="1" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Highlights" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeHighlights" Minimum="-100" Maximum="100" Value="0" ValueChanged="IeAdjust_Changed"/>
                                        <TextBlock x:Name="TxtIeHighlightsVal" Grid.Column="1" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Shadows" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeShadows" Minimum="-100" Maximum="100" Value="0" ValueChanged="IeAdjust_Changed"/>
                                        <TextBlock x:Name="TxtIeShadowsVal" Grid.Column="1" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Temperature" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeTemperature" Minimum="-100" Maximum="100" Value="0" ValueChanged="IeAdjust_Changed"/>
                                        <TextBlock x:Name="TxtIeTempVal" Grid.Column="1" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <Button Content="Apply Adjustments" Padding="0,8" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="IeAdjust_Apply" HorizontalContentAlignment="Center" Template="{StaticResource RoundedButton21}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- FILTERS -->
                                <StackPanel x:Name="IeSecFilters" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="FILTERS" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="Grayscale" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="grayscale"/>
                                        <Button Content="Sepia" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="sepia"/>
                                        <Button Content="Invert" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="invert"/>
                                        <Button Content="Warm" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="warm"/>
                                        <Button Content="Cool" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="cool"/>
                                        <Button Content="Vintage" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="vintage"/>
                                        <Button Content="HDR" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="hdr"/>
                                        <Button Content="B&amp;W High" Padding="10,6" Margin="0,0,6,6" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeFilter_Click" Tag="bw_high_contrast"/>
                                    </WrapPanel>
                                </StackPanel>
                                <!-- WATERMARK -->
                                <StackPanel x:Name="IeSecWatermark" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="WATERMARK" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Text" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtIeWatermarkText" Height="28" Padding="6,3" FontSize="11" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Margin="0,0,0,10" Text="&#x00A9; Copyright"/>
                                    <TextBlock Text="Color" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbIeWmColor" Height="28" FontSize="11" SelectedIndex="0" Margin="0,0,0,10">
                                        <ComboBoxItem Content="White"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Red"/><ComboBoxItem Content="Yellow"/>
                                    </ComboBox>
                                    <TextBlock Text="Font Size" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeWmFontSize" Minimum="12" Maximum="120" Value="36"/>
                                        <TextBlock x:Name="TxtIeWmFontVal" Grid.Column="1" Text="36" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Opacity" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeWmOpacity" Minimum="10" Maximum="100" Value="50"/>
                                        <TextBlock x:Name="TxtIeWmOpacVal" Grid.Column="1" Text="50%" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Position" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbIeWmPosition" Height="28" FontSize="11" SelectedIndex="4" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Top Left"/><ComboBoxItem Content="Top Center"/><ComboBoxItem Content="Top Right"/>
                                        <ComboBoxItem Content="Center Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Center Right"/>
                                        <ComboBoxItem Content="Bottom Left"/><ComboBoxItem Content="Bottom Center"/><ComboBoxItem Content="Bottom Right"/>
                                    </ComboBox>
                                    <Button Content="Apply Watermark" Padding="0,8" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="IeWatermark_Apply" HorizontalContentAlignment="Center" Template="{StaticResource RoundedButton21}"/>
                                </StackPanel>
                                <!-- COMPRESS -->
                                <StackPanel x:Name="IeSecCompress" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="COMPRESS" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Quality" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SldIeCompressQuality" Minimum="10" Maximum="100" Value="85" ValueChanged="IeCompress_QualityChanged"/>
                                        <TextBlock x:Name="TxtIeCompressQuality" Grid.Column="1" Text="85%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid><TextBlock Text="Original:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBlock x:Name="TxtIeCompressOrigSize" Text="0 MB" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,4,0,0"><TextBlock Text="Estimated:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBlock x:Name="TxtIeCompressEstSize" Text="0 MB" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Apply Compression" Padding="0,8" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="IeCompress_Apply" HorizontalContentAlignment="Center" Template="{StaticResource RoundedButton21}"/>
                                </StackPanel>
                                <!-- CONVERT -->
                                <StackPanel x:Name="IeSecConvert" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="CONVERT" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Output Format" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbIeConvertFormat" Height="28" FontSize="11" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="IeConvertFormat_Changed">
                                        <ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/><ComboBoxItem Content="BMP"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="GIF"/>
                                    </ComboBox>
                                    <TextBlock Text="JPEG Quality (for JPG)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <Slider x:Name="SldIeConvertQuality" Minimum="10" Maximum="100" Value="90" Margin="0,0,0,8" ValueChanged="IeCompress_QualityChanged"/>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                        <TextBlock x:Name="TxtIeConvertEstSize" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Content="Save As Format" Padding="0,8" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="IeConvert_Save" HorizontalContentAlignment="Center" Template="{StaticResource RoundedButton21}"/>
                                </StackPanel>
                                <StackPanel x:Name="IeSecBackground" Margin="16,16" Visibility="Collapsed">
                                    <TextBlock Text="BACKGROUND (AI)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Detects the main subject and removes, blurs or replaces everything behind it. Downloads a model once (~168 MB)." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Content="&#x2728;  Remove background" Padding="0,9" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="IeBgRemove_Click" HorizontalContentAlignment="Center" Template="{StaticResource RoundedButton21}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Blur strength" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Slider x:Name="SldIeBgBlur" Minimum="2" Maximum="40" Value="14" Margin="0,0,0,6"/>
                                    <Button Content="Blur background" Padding="0,8" FontSize="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeBgBlur_Click" HorizontalContentAlignment="Center" Margin="0,0,0,12"/>

                                    <TextBlock Text="Replace colour (hex)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtIeBgColor" Text="#FFFFFF" Height="28" FontSize="11" Margin="0,0,0,6"/>
                                    <Button Content="Replace background colour" Padding="0,8" FontSize="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Cursor="Hand" Click="IeBgReplace_Click" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <!-- Bottom -->
                <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="HISTORY" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtIeCurrentSize" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Original" Padding="10,5" FontSize="11" Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="IeShowOriginal_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnIeCompare" Content="Compare" Padding="10,5" FontSize="11"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                    Cursor="Hand" PreviewMouseLeftButtonDown="IeCompare_Down" PreviewMouseLeftButtonUp="IeCompare_Up"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ====================== 16. PanelCompressOffice ====================== -->
        <Grid x:Name="PanelCompressOffice" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="CompressOfficeSelectView" AllowDrop="True"
                          Drop="CompressOffice_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Compress Office" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Reduce Office document file size" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select Office files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#78909C" Cursor="Hand" Click="CompressOffice_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop Office files here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="CompressOfficeConfigView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Center">
                    <TextBlock Text="+ Add more files" Foreground="{DynamicResource AccentBrush}" FontSize="13" Cursor="Hand"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               MouseLeftButtonDown="CompressOffice_AddMore"/>
                    <ListBox x:Name="CompressOfficeList" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                             BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" MaxHeight="200" MinHeight="40"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="3" Content="&#x25CE;" Width="24" Height="24" FontSize="12"
                                            Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" VerticalAlignment="Center"
                                            ToolTip="Preview" Margin="0,0,4,0"/>
                                    <Button Grid.Column="4" Content="&#x2715;" Width="24" Height="24" FontSize="10"
                                            Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="CompressOffice_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SldOfficeQuality" Grid.Column="1" Minimum="10" Maximum="100" Value="80"
                                VerticalAlignment="Center" ValueChanged="CompressOffice_QualityChanged"/>
                        <TextBlock x:Name="TxtOfficeQualityVal" Grid.Column="2" Text="80" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Width="30" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Compress All &#x2192;" Width="280" Height="50" Margin="0,20,0,0"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#78909C"
                            HorizontalAlignment="Center" Cursor="Hand" Click="CompressOffice_Execute"
                            Template="{StaticResource RoundedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== 17. PanelVideoTools (unified) ====================== -->
        <Grid x:Name="PanelVideoTools" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="VideoSelectView" AllowDrop="True"
                          Drop="VideoTools_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Video Tools" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Trim, crop, rotate, flip &amp; export" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select video file" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="{DynamicResource AccentBrush}" Cursor="Hand" Click="VideoTools_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop a video here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== Video Editor: 3-panel layout ===== -->
            <Grid x:Name="VideoConfigView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- File info bar -->
                    <RowDefinition Height="*"/>      <!-- Main 3-column area -->
                    <RowDefinition Height="Auto"/>   <!-- Timeline -->
                    <RowDefinition Height="Auto"/>   <!-- Bottom bar -->
                </Grid.RowDefinitions>

                <!-- Row 0: File info bar -->
                <Border Background="{DynamicResource WindowBrush}" Padding="12,6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVideoFileName" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtVideoInfo" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Left sidebar + Center preview + Right properties -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>    <!-- Tool sidebar -->
                        <ColumnDefinition Width="*"/>     <!-- Preview -->
                        <ColumnDefinition Width="210"/>   <!-- Properties -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Tool sidebar -->
                    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="0,12,0,0">
                            <Button x:Name="BtnToolTrim" Tag="trim" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x2702;" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Trim" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolCrop" Tag="crop" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x2B1C;" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Crop" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolRotate" Tag="rotate" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x21BB;" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rotate" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolFlip" Tag="flip" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x21C5;" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Flip" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToolInfo" Tag="info" Click="VideoToolSelect_Click"
                                    Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x24D8;" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Info" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- CENTER: Video preview + playback controls -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>     <!-- Preview -->
                            <RowDefinition Height="Auto"/>  <!-- Playback controls -->
                        </Grid.RowDefinitions>

                        <!-- Video preview -->
                        <Border Background="{DynamicResource WindowBrush}" Margin="0">
                            <Grid ClipToBounds="True">
                                <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" MediaOpened="VideoPreview_MediaOpened"
                                              MediaEnded="VideoPreview_MediaEnded">
                                    <MediaElement.LayoutTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="VideoFlipTransform" ScaleX="1" ScaleY="1"/>
                                            <RotateTransform x:Name="VideoRotateTransform" Angle="0"/>
                                        </TransformGroup>
                                    </MediaElement.LayoutTransform>
                                </MediaElement>
                                <Canvas x:Name="VideoCropCanvas" Background="Transparent" Visibility="Collapsed"
                                        MouseLeftButtonDown="VideoCrop_MouseDown"
                                        MouseMove="VideoCrop_MouseMove"
                                        MouseLeftButtonUp="VideoCrop_MouseUp"/>
                            </Grid>
                        </Border>

                        <!-- Playback controls bar -->
                        <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" Padding="10,6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Time -->
                                <TextBlock x:Name="TxtVideoTime" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                           VerticalAlignment="Center" Text="00:00:00 / 00:00:00"/>
                                <!-- Playback buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="&#x23EE;" FontSize="16" Width="32" Height="32"
                                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="VideoSetTrimStart" ToolTip="Jump to start"/>
                                    <Button x:Name="BtnVideoPlay" Content="&#x25B6;" FontSize="18" Width="38" Height="38"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            Click="VideoPlay_Click" Margin="4,0"/>
                                    <Button Content="&#x23ED;" FontSize="16" Width="32" Height="32"
                                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="VideoSetTrimEnd" ToolTip="Jump to end"/>
                                    <Button Content="&#x1F50A;" FontSize="13" Width="32" Height="32"
                                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand"
                                            Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT: Properties panel -->
                    <Border Grid.Column="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12,14,12">

                                <!-- Crop Section -->
                                <StackPanel x:Name="VideoPropCrop">
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Crop" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Reset" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"
                                                       Cursor="Hand" Margin="0,0,8,0" MouseLeftButtonDown="VideoCropReset_Click"/>
                                            <Button x:Name="BtnVideoCropToggle" Content="&#x2714;" Width="38" Height="22" FontSize="11"
                                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                                    Click="VideoCrop_Toggle" ToolTip="Toggle crop"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Aspect Ratio" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbVideoCropAspect" Width="180" Height="28" FontSize="11" SelectedIndex="0"
                                              HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Free"/>
                                        <ComboBoxItem Content="16:9 (Widescreen)"/>
                                        <ComboBoxItem Content="4:3 (Standard)"/>
                                        <ComboBoxItem Content="1:1 (Square)"/>
                                        <ComboBoxItem Content="9:16 (Portrait)"/>
                                    </ComboBox>
                                    <TextBlock Text="Position" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropX" Grid.Column="1" Height="26" Padding="6,2" FontSize="11"
                                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="0"/>
                                        <TextBlock Grid.Column="3" Text="Y" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropY" Grid.Column="4" Height="26" Padding="6,2" FontSize="11"
                                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="0"/>
                                    </Grid>
                                    <TextBlock Text="Size" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="W" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropW" Grid.Column="1" Height="26" Padding="6,2" FontSize="11"
                                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="0"/>
                                        <TextBlock Grid.Column="3" Text="H" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtVideoCropH" Grid.Column="4" Height="26" Padding="6,2" FontSize="11"
                                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Text="0"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtVideoCropInfo" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource SurfaceBrush}" Height="1" Margin="0,4,0,12"/>
                                </StackPanel>

                                <!-- Rotate Section -->
                                <StackPanel x:Name="VideoPropRotate">
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Rotate" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reset" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="VideoRotateReset_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="&#x21BA;" FontSize="18" Height="36"
                                                Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                                Click="VideoRotate_CCW" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="&#x21BB;" FontSize="18" Height="36"
                                                Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                                Click="VideoRotate_CW" Margin="0,0,4,0"/>
                                        <Border Grid.Column="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                                CornerRadius="4" Height="36">
                                            <TextBlock x:Name="TxtVideoAngle" Text="0&#x00B0;" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <Border Background="{DynamicResource SurfaceBrush}" Height="1" Margin="0,4,0,12"/>
                                </StackPanel>

                                <!-- Flip Section -->
                                <StackPanel x:Name="VideoPropFlip">
                                    <TextBlock Text="Flip" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnVideoFlipH" Content="&#x2194; Horizontal" Height="36" FontSize="12"
                                                Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                                Click="VideoFlip_H"/>
                                        <Button x:Name="BtnVideoFlipV" Grid.Column="2" Content="&#x2195; Vertical" Height="36" FontSize="12"
                                                Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                                Click="VideoFlip_V"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtVideoTransform" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <Border Background="{DynamicResource SurfaceBrush}" Height="1" Margin="0,4,0,12"/>
                                </StackPanel>

                                <!-- Info Section -->
                                <StackPanel x:Name="VideoPropInfo" Visibility="Collapsed">
                                    <TextBlock Text="File Info" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtVideoDetailInfo" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                               TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Row 2: Timeline -->
                <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" Padding="8,4" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Timeline bar -->
                            <RowDefinition Height="Auto"/>  <!-- Time labels -->
                        </Grid.RowDefinitions>

                        <Grid x:Name="VideoTimelineContainer" Height="44" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="VideoTimeline_MouseDown"
                              MouseMove="VideoTimeline_MouseMove"
                              MouseLeftButtonUp="VideoTimeline_MouseUp">
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Height="40" VerticalAlignment="Center"/>
                            <Border x:Name="VtTrimRegion" CornerRadius="4" Height="40" VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00897B" Offset="0"/>
                                        <GradientStop Color="#00695C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="VtHandleLeft" Width="12" Height="44" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Cursor="SizeWE" Background="{DynamicResource AccentBrush}" CornerRadius="3,0,0,3">
                                <Border Width="2" Height="20" Background="White" CornerRadius="1"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="VtHandleRight" Width="12" Height="44" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Cursor="SizeWE" Background="{DynamicResource AccentBrush}" CornerRadius="0,3,3,0">
                                <Border Width="2" Height="20" Background="White" CornerRadius="1"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="VtPlayhead" Width="2" Height="48" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="#4DB6AC"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VtStartLabel" Text="00:00:00" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VtDurationLabel" Grid.Column="1" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="VtEndLabel" Grid.Column="2" Text="00:00:00" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 3: Bottom bar — trim inputs + export -->
                <Border Grid.Row="3" Background="{DynamicResource WindowBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Start -->
                            <ColumnDefinition Width="Auto"/>  <!-- Duration -->
                            <ColumnDefinition Width="*"/>     <!-- Spacer -->
                            <ColumnDefinition Width="Auto"/>  <!-- Export info -->
                            <ColumnDefinition Width="Auto"/>  <!-- Export button -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="Start" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVtStartTime" Text="00:00:00.000" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Set Start" Height="26" Padding="10,0" FontSize="10"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                    Click="VideoSetTrimStart" Template="{StaticResource RoundedButton21}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="Duration" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVtDuration" Text="00:00:00.000" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Set End" Height="26" Padding="10,0" FontSize="10"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                    Click="VideoSetTrimEnd" Template="{StaticResource RoundedButton21}"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtVideoExportInfo" Grid.Column="3" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Button Grid.Column="4" Content="Export Video" Width="160" Height="38"
                                FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#00897B"
                                Cursor="Hand" Click="VideoExport_Execute"
                                Template="{StaticResource RoundedButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ====================== PanelExtractAudio ====================== -->
        <Grid x:Name="PanelExtractAudio" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="ExtractAudioSelectView" AllowDrop="True"
                          Drop="ExtractAudio_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Extract Audio" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Extract audio from one or more video files and save in your preferred format." FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select video files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#00BCD4" Cursor="Hand" Click="ExtractAudio_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop videos here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Review & Download-style card grid for Extract Audio -->
            <Grid x:Name="ExtractAudioConfigView" Visibility="Collapsed" Margin="16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- results header: title/count + add/filter/sort/view -->
                    <RowDefinition Height="*"/>       <!-- body: card grid / list -->
                    <RowDefinition Height="Auto"/>   <!-- bottom bar: settings + extract -->
                </Grid.RowDefinitions>

                <!-- Row 0: header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Select files to extract audio" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtExtAudioFileCount" Text="0 files selected" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ Add Files" FontSize="12" Height="32" Padding="12,0"
                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                Click="ExtractAudio_AddMoreBtn" Template="{StaticResource RoundedButton21}" Margin="0,0,8,0"/>
                        <Button Content="&#x1F4C1; Add Folder" FontSize="12" Height="32" Padding="12,0"
                                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                Click="ExtractAudio_AddFolder" Template="{StaticResource RoundedButton21}" Margin="0,0,14,0"/>
                        <!-- Filter loaded videos by name -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                Height="32" Width="190" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="TxtExtAudioFilter" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalContentAlignment="Center"
                                             TextChanged="ExtractAudio_FilterChanged"/>
                                    <TextBlock x:Name="TxtExtAudioFilterPh" Text="Filter files…" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="ChkExtAudioSelectAll" Content="Select All" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                  IsChecked="True" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,14,0"
                                  Click="ExtractAudio_SelectAllToggle"/>
                        <ComboBox x:Name="CmbExtAudioSort" Width="150" Height="32" FontSize="12" Margin="0,0,10,0"
                                  SelectedIndex="0" SelectionChanged="ExtractAudio_SortChanged">
                            <ComboBoxItem Content="Added order"/>
                            <ComboBoxItem Content="Selected first"/>
                            <ComboBoxItem Content="Name (A–Z)"/>
                            <ComboBoxItem Content="Longest first"/>
                        </ComboBox>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnExtAudioGridView" Content="&#xF0E2;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28"
                                        FontSize="13" Background="#00BCD4" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Click="ExtractAudio_GridView"/>
                                <Button x:Name="BtnExtAudioListView" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28"
                                        FontSize="13" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                                        Click="ExtractAudio_ListView"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 1: card (grid) view -->
                <ListBox x:Name="ExtractAudioGrid" Grid.Row="1"
                         IsSynchronizedWithCurrentItem="False" SelectionMode="Extended"
                         MouseDoubleClick="ExtractAudio_ItemDoubleClick"
                         Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderThickness="2" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#00BCD4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid Background="{DynamicResource SurfaceBrush}" Height="124" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" HorizontalAlignment="Stretch" Height="124"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- film placeholder shown until the thumbnail loads -->
                                        <TextBlock Text="&#x1F3AC;" FontSize="34" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- checkbox (top-left) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                Background="{DynamicResource ScrimBrush}" CornerRadius="3" Padding="3,2">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      IsHitTestVisible="False" Focusable="False"/>
                                        </Border>
                                        <!-- duration badge (top-right) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                Background="{DynamicResource ScrimBrush}" CornerRadius="3" Padding="5,2">
                                            <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"/>
                                        </Border>
                                        <!-- status badge (bottom-right), hidden until extraction starts -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                Background="{DynamicResource ScrimBrush}" CornerRadius="3" Padding="5,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="8,6,6,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="15"/>
                                            <TextBlock Text="{Binding MetaLine}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="&#x25B6;" FontSize="11" Width="26" Height="26"
                                                    Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                                    Click="PreviewFile_Click" Tag="{Binding FilePath}" ToolTip="Preview"/>
                                            <Button Content="&#x1F5D1;" FontSize="13" Width="26" Height="26"
                                                    Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                                                    Click="ExtractAudio_Remove" Tag="{Binding FilePath}" ToolTip="Remove"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"
                                                 Margin="8,0,8,8"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Row 1: list (row) view -->
                <ListBox x:Name="ExtractAudioListView" Grid.Row="1" Visibility="Collapsed"
                         IsSynchronizedWithCurrentItem="False" SelectionMode="Extended"
                         MouseDoubleClick="ExtractAudio_ItemDoubleClick"
                         Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#252528"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" VerticalAlignment="Center"
                                          IsHitTestVisible="False" Focusable="False" Margin="0,0,8,0"/>
                                <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="120" Height="68"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,120,68" RadiusX="4" RadiusY="4"/>
                                    </Image.Clip>
                                </Image>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding MetaLine}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="&#x23F1; " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#x25B6;" FontSize="12" Width="30" Height="30"
                                            Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="PreviewFile_Click" Tag="{Binding FilePath}" ToolTip="Preview"/>
                                    <Button Content="&#x1F5D1;" FontSize="14" Width="30" Height="30"
                                            Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                                            Click="ExtractAudio_Remove" Tag="{Binding FilePath}" ToolTip="Remove"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Row 2: bottom bar — output settings + save-to + extract -->
                <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                        Margin="0,12,0,0" Padding="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>   <!-- output settings -->
                            <ColumnDefinition Width="Auto"/>   <!-- save to -->
                            <ColumnDefinition Width="*"/>       <!-- progress -->
                            <ColumnDefinition Width="Auto"/>   <!-- extract -->
                        </Grid.ColumnDefinitions>

                        <!-- Output settings -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Format" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbExtAudioFormat" Width="90" Height="30" FontSize="12" SelectedIndex="0" Margin="0,0,14,0">
                                    <ComboBoxItem Content="MP3"/>
                                    <ComboBoxItem Content="WAV"/>
                                    <ComboBoxItem Content="AAC"/>
                                    <ComboBoxItem Content="FLAC"/>
                                </ComboBox>
                                <TextBlock Text="Quality" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbExtAudioQuality" Width="180" Height="30" FontSize="12" SelectedIndex="0">
                                    <ComboBoxItem Content="320 kbps (High Quality)"/>
                                    <ComboBoxItem Content="256 kbps"/>
                                    <ComboBoxItem Content="192 kbps (Standard)"/>
                                    <ComboBoxItem Content="128 kbps (Small)"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="ChkExtAudioThumb" Content="Embed thumbnail as album art"
                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" IsChecked="True" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Save to -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                            <RadioButton x:Name="RbExtAudioNew" Content="New folder" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                         IsChecked="True" Cursor="Hand" GroupName="ExtAudioSave" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExtAudioOutputFolder" Height="26" Padding="8,2" FontSize="11"
                                         Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" IsReadOnly="True"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Browse" FontSize="11" Padding="10,4"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                        Click="ExtractAudio_BrowseFolder" Template="{StaticResource RoundedButton21}" Margin="6,0,0,0"/>
                            </Grid>
                            <RadioButton x:Name="RbExtAudioOverwrite" Content="Same folder as source" Foreground="{DynamicResource TextSecondaryBrush}"
                                         FontSize="12" Cursor="Hand" GroupName="ExtAudioSave" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Overall progress -->
                        <TextBlock x:Name="TxtExtAudioOverall" Grid.Column="2" Text="" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Extract button -->
                        <Button x:Name="BtnExtAudioExtract" Grid.Column="3" Width="200" Height="56" Cursor="Hand"
                                Background="#00897B" Foreground="White" BorderThickness="0" Click="ExtractAudio_Execute"
                                Template="{StaticResource RoundedButton}">
                            <StackPanel>
                                <TextBlock Text="Extract Audio  →" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtExtAudioTotalSize" Text="0 selected" FontSize="11" Opacity="0.85" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ====================== PanelTrimAudio ====================== -->
        <Grid x:Name="PanelTrimAudio" Grid.Row="1" Visibility="Collapsed">
            <!-- Select view: multi-file -->
            <Border x:Name="TrimAudioSelectView" AllowDrop="True"
                          Drop="TrimAudio_SelectDrop" DragOver="Generic_DragOver"
                          Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Trim Audio" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Cut start and end of multiple audio files" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Content="Select audio files" Width="280" Height="50"
                            FontSize="16" FontWeight="SemiBold" Foreground="White"
                            Background="#009688" Cursor="Hand" Click="TrimAudio_SelectFiles"
                            Margin="0,0,0,16" Template="{StaticResource RoundedButton}"/>
                    <TextBlock Text="or drop audio files here" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Config view: sidebar + main -->
            <Grid x:Name="TrimAudioConfigView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left sidebar: file list -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Margin="12,12,12,8">
                            <TextBlock x:Name="TxtTrimFileCount" Text="Files (0)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="+ Add" FontSize="11" Padding="8,4" HorizontalAlignment="Right"
                                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                    Click="TrimAudio_AddMore" Template="{StaticResource RoundedButton21}"/>
                        </Grid>

                        <!-- File list -->
                        <ListBox x:Name="TrimAudioFileList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="TrimAudio_FileSelected"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#232328"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#15332F"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#4DB6AC"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6">
                                            <TextBlock Text="&#x266B;" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                            <TextBlock Text="{Binding Extra}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <Button Grid.Column="3" Content="&#x2715;" Width="18" Height="18" FontSize="9"
                                                Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Cursor="Hand"
                                                Click="TrimAudio_Remove" Tag="{Binding FilePath}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Total duration -->
                        <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" Padding="12,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock Text="Total Duration" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtTrimTotalDuration" Text="00:00" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                           FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right main area -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Trim settings bar -->
                        <RowDefinition Height="*"/>      <!-- Waveform rows -->
                        <RowDefinition Height="Auto"/>   <!-- Bottom bar -->
                    </Grid.RowDefinitions>

                    <!-- Trim settings bar -->
                    <Border Background="{DynamicResource SurfaceBrush}" Padding="16,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Trim Settings" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"
                                       Text="Drag the handles on each wave, or use Suggest trims. Zoom in for finer cuts."/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnTrimSuggest" Content="&#x2728; Suggest trims" FontSize="11" Padding="10,5"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                        Click="TrimAudio_SuggestTrims" Template="{StaticResource RoundedButton21}"
                                        ToolTip="Auto-detect quiet dips, mark them, and snap the trim handles"
                                        Margin="0,0,8,0"/>
                                <Button Content="Apply to All" FontSize="11" Padding="10,5"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                        Click="TrimAudio_ApplyToAll" Template="{StaticResource RoundedButton21}"
                                        ToolTip="Apply the active file's cut points to every file"
                                        Margin="0,0,8,0"/>
                                <Button Content="Reset" FontSize="11" Padding="10,5"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                        Click="TrimAudio_Reset" Template="{StaticResource RoundedButton21}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Waveform rows (built programmatically) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TrimWaveformPanel"/>
                    </ScrollViewer>

                    <!-- Bottom bar -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="16,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="Format" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbTrimAudioFormat" Width="100" Height="28" FontSize="12" SelectedIndex="0">
                                    <ComboBoxItem Content="Original"/>
                                    <ComboBoxItem Content="MP3"/>
                                    <ComboBoxItem Content="WAV"/>
                                    <ComboBoxItem Content="FLAC"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Output Folder" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtTrimOutputFolder" Width="220" Height="28" Padding="6,2" FontSize="11"
                                         Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" IsReadOnly="True"/>
                                <Button Content="&#x1F4C1;" FontSize="13" Width="30" Height="28"
                                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                        Click="TrimAudio_BrowseFolder" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="&#x2702; Trim All" Width="160" Height="40"
                                    FontSize="15" FontWeight="SemiBold" Foreground="White" Background="#009688"
                                    Cursor="Hand" Click="TrimAudio_Execute"
                                    Template="{StaticResource RoundedButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ====================== PanelYouTubeDl ====================== -->
        <Grid x:Name="PanelYouTubeDl" Grid.Row="1" Visibility="Collapsed">
            <Grid.Resources>
                <!-- Segmented toggle (Videos | Playlists) built on RadioButton — shared by hero + results -->
                <Style x:Key="YtSegment" TargetType="RadioButton">
                    <Setter Property="Foreground" Value="#AAA"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Seg" Background="Transparent" CornerRadius="6" Padding="14,7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Seg" Property="Background" Value="#FF0000"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#EEE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Border x:Name="YtSelectView" Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="640">
                    <!-- YouTube logo + title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border Background="#FF0000" CornerRadius="7" Width="46" Height="32" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#x25B6;" Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="YouTube Downloader" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Search YouTube or paste a video / playlist link to download" FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,34"/>
                    <!-- Search bar (magnifier + input) + red Search -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" BorderThickness="1.5" Height="50">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="#FF0000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,10,0"/>
                                <TextBox x:Name="TxtYtUrl" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" VerticalContentAlignment="Center"
                                         CaretBrush="#FF0000" KeyDown="Yt_UrlKeyDown" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Content="Search" Width="120" Height="50" FontSize="15" FontWeight="SemiBold"
                                Foreground="White" Background="#FF0000" Cursor="Hand" Click="Yt_Fetch" Margin="12,0,0,0"
                                Template="{StaticResource RoundedButton}"/>
                    </Grid>
                    <!-- Videos / Playlists segmented toggle -->
                    <Border HorizontalAlignment="Center" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbYtModeVideos" Style="{StaticResource YtSegment}" Content="Videos"
                                         GroupName="YtSearchMode" IsChecked="True"/>
                            <RadioButton x:Name="RbYtModePlaylists" Style="{StaticResource YtSegment}" Content="Playlists"
                                         GroupName="YtSearchMode"/>
                        </StackPanel>
                    </Border>
                    <!-- Source: YouTube / Music. Music routes searches to YouTube Music songs. -->
                    <Border HorizontalAlignment="Center" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" Padding="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbYtSourceYouTube" Style="{StaticResource YtSegment}" Content="YouTube"
                                         GroupName="YtSource" IsChecked="True" Checked="YtSource_Changed"/>
                            <RadioButton x:Name="RbYtSourceMusic" Style="{StaticResource YtSegment}" Content="Music"
                                         GroupName="YtSource" Checked="YtSource_Changed"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Tip: paste a URL to download directly, or type keywords to search"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <!-- Loading spinner (shown while fetching) -->
                    <StackPanel x:Name="YtSpinner" Visibility="Collapsed" Margin="0,30,0,0" HorizontalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" BorderThickness="3"
                                RenderTransformOrigin="0.5,0.5" x:Name="YtSpinnerBorder">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="0.7"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.RenderTransform>
                                <RotateTransform x:Name="YtSpinnerRotate" Angle="0"/>
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock x:Name="TxtYtSpinner" Text="Fetching video info..." Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Config state -->
            <Grid x:Name="YtConfigView" Visibility="Collapsed" Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- FILTERS sidebar (collapses to 0 on review) -->
                    <ColumnDefinition Width="*"/>      <!-- main content -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Top search bar -->
                    <RowDefinition Height="Auto"/>   <!-- Results header: title/count + select all + sort + view toggle -->
                    <RowDefinition Height="*"/>       <!-- Body: sidebar (col0) + video views (col1) -->
                    <RowDefinition Height="Auto"/>   <!-- Bottom bar / download controls -->
                </Grid.RowDefinitions>

                <!-- Row 0: top search bar (magnifier + clear + Search + Videos/Playlists segment) -->
                <Grid x:Name="YtTopSearchBar" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" BorderThickness="1.5" Height="44">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="#FF0000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,10,0"/>
                            <TextBox x:Name="TxtYtUrlTop" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalContentAlignment="Center"
                                     CaretBrush="#FF0000" KeyDown="Yt_UrlTopKeyDown"/>
                            <Button x:Name="BtnYtClear" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                    Width="30" Height="30" FontSize="11" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                                    BorderThickness="0" Cursor="Hand" Click="Yt_ClearResults" Margin="0,0,8,0"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="Search" Height="44" Width="120" FontSize="14" FontWeight="SemiBold"
                            Foreground="White" Background="#FF0000" Cursor="Hand" Click="Yt_FetchTop"
                            Template="{StaticResource RoundedButton}" Margin="12,0,0,0"/>
                    <Border Grid.Column="2" Margin="12,0,0,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbYtModeVideosTop" Style="{StaticResource YtSegment}" Content="Videos"
                                         GroupName="YtSearchModeTop" IsChecked="True"/>
                            <RadioButton x:Name="RbYtModePlaylistsTop" Style="{StaticResource YtSegment}" Content="Playlists"
                                         GroupName="YtSearchModeTop"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: results header — title/count (left); Select All + sort + view toggle (right) -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtYtTitle" Text="" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48"/>
                        <TextBlock x:Name="TxtYtDetail" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnYtOpenPlaylist" Content="Open playlist →" Height="30" FontSize="12" Padding="12,0"
                                Background="#FF0000" Foreground="White" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                Click="Yt_OpenPlaylist" Visibility="Collapsed" Margin="0,0,8,0"
                                Template="{StaticResource RoundedButton21}"/>
                        <!-- Download screen: filter the loaded videos by title -->
                        <Border x:Name="YtDownloadFilterBox" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Height="32" Width="200" Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="TxtYtDownloadFilter" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalContentAlignment="Center"
                                             TextChanged="Yt_DownloadFilterChanged"/>
                                    <TextBlock x:Name="TxtYtDownloadFilterPh" Text="Filter videos…" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="ChkYtSelectAll" Content="Select All" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                  VerticalAlignment="Center" Cursor="Hand" Margin="0,0,14,0" Click="Yt_SelectAllToggle"/>
                        <ComboBox x:Name="CmbYtSortHeader" Width="150" Height="32" FontSize="12" Margin="0,0,10,0"
                                  SelectedIndex="0" SelectionChanged="Yt_SortChanged">
                            <ComboBoxItem Content="Relevance"/>
                            <ComboBoxItem Content="Upload date"/>
                            <ComboBoxItem Content="View count"/>
                            <ComboBoxItem Content="Rating"/>
                        </ComboBox>
                        <!-- Download screen: local re-ordering of the loaded list -->
                        <ComboBox x:Name="CmbYtDownloadSort" Width="150" Height="32" FontSize="12" Margin="0,0,10,0"
                                  Visibility="Collapsed" SelectedIndex="0" SelectionChanged="Yt_DownloadSortChanged">
                            <ComboBoxItem Content="Playlist order"/>
                            <ComboBoxItem Content="Selected first"/>
                            <ComboBoxItem Content="Title (A–Z)"/>
                            <ComboBoxItem Content="Longest first"/>
                        </ComboBox>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnYtGridView" Content="&#xF0E2;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28"
                                        FontSize="13" Background="#FF0000" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Click="Yt_GridView"/>
                                <Button x:Name="BtnYtListView" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28"
                                        FontSize="13" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                                        Click="Yt_ListView"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Legacy controls kept (hidden) so existing handlers stay valid; superseded by the new UI -->
                <StackPanel Grid.Row="1" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False">
                    <Button x:Name="BtnYtGoDownload" Click="Yt_GoToDownload"/>
                    <Button x:Name="BtnYtSelectAll" Click="Yt_SelectAll"/>
                    <Button x:Name="BtnYtDeselectAll" Click="Yt_DeselectAll"/>
                    <Button x:Name="BtnYtCheckedFirst" Click="Yt_CheckedFirst"/>
                    <Grid x:Name="YtSearchBox">
                        <TextBox x:Name="TxtYtSearch" TextChanged="Yt_SearchChanged"/>
                        <TextBlock x:Name="TxtYtSearchPlaceholder"/>
                    </Grid>
                    <TextBlock x:Name="TxtYtSelectedCount"/>
                </StackPanel>

                <!-- Body col0: FILTERS sidebar (hidden on the review screen) -->
                <Border x:Name="YtFiltersPanel" Grid.Row="2" Grid.Column="0" Width="190" Margin="0,0,16,0"
                        Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <DockPanel>
                        <Button x:Name="BtnYtClearFilters" DockPanel.Dock="Bottom" Content="↺  Clear filters" Height="36"
                                FontSize="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" Cursor="Hand"
                                Click="Yt_ClearFilters" Margin="0,12,0,0"/>
                        <StackPanel>
                            <TextBlock Text="FILTERS" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Upload date" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel x:Name="YtUploadDateGroup">
                                <RadioButton Content="Any time" Tag="any" GroupName="YtUploadDate" IsChecked="True"
                                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Cursor="Hand" Margin="0,3" Checked="Yt_FilterChanged"/>
                                <RadioButton Content="Today" Tag="today" GroupName="YtUploadDate"
                                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Cursor="Hand" Margin="0,3" Checked="Yt_FilterChanged"/>
                                <RadioButton Content="This week" Tag="week" GroupName="YtUploadDate"
                                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Cursor="Hand" Margin="0,3" Checked="Yt_FilterChanged"/>
                                <RadioButton Content="This month" Tag="month" GroupName="YtUploadDate"
                                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Cursor="Hand" Margin="0,3" Checked="Yt_FilterChanged"/>
                                <RadioButton Content="This year" Tag="year" GroupName="YtUploadDate"
                                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Cursor="Hand" Margin="0,3" Checked="Yt_FilterChanged"/>
                            </StackPanel>
                            <TextBlock Text="Sort by" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,8"/>
                            <ComboBox x:Name="CmbYtSort" Height="32" FontSize="12" SelectedIndex="0" SelectionChanged="Yt_SortChanged">
                                <ComboBoxItem Content="Relevance"/>
                                <ComboBoxItem Content="Upload date"/>
                                <ComboBoxItem Content="View count"/>
                                <ComboBoxItem Content="Rating"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Video list (row) view -->
                <ListBox x:Name="YtVideoList" Grid.Row="2" Grid.Column="1" Visibility="Collapsed"
                         IsSynchronizedWithCurrentItem="False" SelectionMode="Extended"
                         PreviewKeyDown="Yt_ListPreviewKeyDown" MouseDoubleClick="Yt_ItemDoubleClick"
                         Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#252528"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#232328"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2B2E36"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" VerticalAlignment="Center"
                                          IsHitTestVisible="False" Focusable="False" Margin="0,0,8,0">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="120" Height="68"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       Margin="0,0,10,0">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,120,68" RadiusX="4" RadiusY="4"/>
                                    </Image.Clip>
                                </Image>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Channel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ViewsAge, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Duration}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"
                                                 Margin="0,4,0,0"/>
                                </StackPanel>
                                <Grid Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                               FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Background="#CCFF0000" CornerRadius="3" Padding="6,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="&#x25B6; Playlist" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Video grid (card) view -->
                <ListBox x:Name="YtVideoGrid" Grid.Row="2" Grid.Column="1"
                         IsSynchronizedWithCurrentItem="False" SelectionMode="Extended"
                         PreviewKeyDown="Yt_ListPreviewKeyDown" MouseDoubleClick="Yt_ItemDoubleClick"
                         Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderThickness="2" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FF3B3B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid Background="{DynamicResource SurfaceBrush}" Height="124" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" HorizontalAlignment="Stretch" Height="124"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                Background="{DynamicResource ScrimBrush}" CornerRadius="3" Padding="3,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      IsHitTestVisible="False" Focusable="False"/>
                                        </Border>
                                        <!-- Playlist badge (top-left), shown only for playlist results -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                Background="#CCFF0000" CornerRadius="3" Padding="5,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="&#x25B6; Playlist" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                Background="{DynamicResource ScrimBrush}" CornerRadius="3" Padding="5,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Duration}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                Background="{DynamicResource ScrimBrush}" CornerRadius="3" Padding="5,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <!-- Hide the status badge until a download is underway -->
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="8,6,6,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="15"/>
                                            <TextBlock Text="{Binding Channel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Channel}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ViewsAge}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ViewsAge}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="&#x22EF;" FontSize="15" Width="26" Height="26"
                                                VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                                                BorderThickness="0" Cursor="Hand" Click="Yt_CardMenu" Tag="{Binding}"
                                                ToolTip="More"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="3"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"
                                                 Margin="8,0,8,8"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- "Loading more…" loader, overlaid at the bottom of the results while paging -->
                <!-- Pagination bar: First / Prev / indicator / Next / Last + page-size input -->
                <Border x:Name="YtPager" Grid.Row="2" Grid.Column="1" Visibility="Collapsed"
                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="48"
                        Background="{DynamicResource ScrimBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BtnYtFirst" Content="⏮ First" Click="Yt_FirstPage" Cursor="Hand"
                                    Height="30" Padding="10,0" Margin="0,0,6,0" Template="{StaticResource RoundedButton}"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button x:Name="BtnYtPrev" Content="◀ Prev" Click="Yt_PrevPage" Cursor="Hand"
                                    Height="30" Padding="10,0" Margin="0,0,12,0" Template="{StaticResource RoundedButton}"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtYtPageIndicator" Text="Page 1" VerticalAlignment="Center" MinWidth="90"
                                       TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <Button x:Name="BtnYtNext" Content="Next ▶" Click="Yt_NextPage" Cursor="Hand"
                                    Height="30" Padding="10,0" Margin="12,0,6,0" Template="{StaticResource RoundedButton}"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button x:Name="BtnYtLast" Content="Last ⏭" Click="Yt_LastPage" Cursor="Hand"
                                    Height="30" Padding="10,0" Template="{StaticResource RoundedButton}"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Per page" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtYtPageSize" Text="12" Width="52" Height="30" VerticalContentAlignment="Center"
                                     TextAlignment="Center" FontSize="13" MaxLength="2"
                                     TextChanged="Yt_PageSizeChanged" LostFocus="Yt_PageSizeLostFocus"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom action bar (search screens): selected count + est. size + Continue -->
                <Border x:Name="YtBottomBar" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed"
                        Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                            <TextBlock Text="Selected" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtYtSelectedVideos" Text="0" Foreground="{DynamicResource DangerBrush}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Videos" Foreground="{DynamicResource DangerBrush}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Estimated size" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="TxtYtEstSize" Text="~0 MB" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button x:Name="BtnYtContinue" Grid.Column="3" Height="56" Width="220" Cursor="Hand"
                                Background="#FF0000" Foreground="White" BorderThickness="0" Click="Yt_GoToDownload"
                                Template="{StaticResource RoundedButton}">
                            <StackPanel>
                                <TextBlock Text="Continue  →" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Review and download" FontSize="11" Opacity="0.85" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Download controls -->
                <Grid x:Name="YtDownloadControls" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbYtVideo" Content="Video" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                     IsChecked="True" GroupName="YtMode" Margin="0,0,12,0" Cursor="Hand"
                                     Checked="YtMode_Changed"/>
                        <RadioButton x:Name="RbYtAudio" Content="Audio" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                     GroupName="YtMode" Cursor="Hand" Checked="YtMode_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="YtVideoOptions" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <ComboBox x:Name="CmbYtQuality" Width="80" Height="28" FontSize="11" SelectedIndex="0"
                                  SelectionChanged="Yt_QualityChanged">
                            <ComboBoxItem Content="Best"/>
                            <ComboBoxItem Content="720p"/>
                            <ComboBoxItem Content="480p"/>
                            <ComboBoxItem Content="360p"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="YtAudioOptions" Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="Format" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbYtAudioFormat" Width="90" Height="28" FontSize="11" SelectedIndex="0">
                            <ComboBoxItem Content="M4A"/>
                            <ComboBoxItem Content="OPUS"/>
                            <ComboBoxItem Content="MP3"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock x:Name="TxtYtOverallProgress" Grid.Column="2" Text="" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <Button x:Name="BtnYtStop" Grid.Column="3" Content="Stop" Width="70" Height="38"
                            FontSize="13" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="Yt_Stop" Visibility="Collapsed" Margin="0,0,8,0"
                            Template="{StaticResource RoundedButton21}"/>

                    <Button x:Name="BtnYtDownload" Grid.Column="4" Content="Download &#x2192;" Width="140" Height="42"
                            FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#FF0000"
                            Cursor="Hand" Click="Yt_Download"
                            Template="{StaticResource RoundedButton}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!--  Processing Overlay (shared, Grid.Row="1")                       -->
        <!-- ================================================================ -->
        <Border x:Name="ProcessingOverlay" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}"
                IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Indeterminate circular spinner (shown for searches / unknown-duration work) -->
                <Border x:Name="MainSpinner" Width="46" Height="46" CornerRadius="23" BorderThickness="4"
                        RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Margin="0,0,0,18"
                        HorizontalAlignment="Center">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3B3B" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.7"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.RenderTransform>
                        <RotateTransform x:Name="MainSpinnerRotate" Angle="0"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock x:Name="TxtProcessing" Text="Processing..." FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar x:Name="MainProgress" Width="350" Height="6" Margin="0,0,0,8"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"
                             Minimum="0" Maximum="100"/>
                <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================================================================ -->
        <!--  Complete Overlay (shared, Grid.Row="1")                         -->
        <!-- ================================================================ -->
        <Border x:Name="CompleteOverlay" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}"
                IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Green checkmark circle -->
                <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource SuccessBrush}" Margin="0,0,0,16">
                    <TextBlock Text="&#x2713;" FontSize="36" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtCompleteMsg" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                <TextBlock x:Name="TxtCompleteDetail" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,20"/>
                <Button x:Name="BtnCompleteOpen" Content="Open File" Width="200" Height="42"
                        FontSize="14" FontWeight="SemiBold" Background="{DynamicResource SuccessBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Complete_OpenFile"
                        Margin="0,0,0,8" Template="{StaticResource RoundedButton21}"/>
                <Button x:Name="BtnCompleteFolder" Content="Open Folder" Width="200" Height="42"
                        FontSize="14" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                        Cursor="Hand" Click="Complete_OpenFolder"
                        Margin="0,0,0,12" Template="{StaticResource RoundedButton21}"/>
                <TextBlock Text="Start Over" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Cursor="Hand"
                           HorizontalAlignment="Center" TextDecorations="Underline"
                           MouseLeftButtonDown="Complete_StartOver"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
