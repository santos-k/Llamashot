<Window x:Class="Llamashot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="Llamashot - Settings"
        Width="520" Height="720" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowGradientBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource SurfaceGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Hotkey input box style -->
        <Style TargetType="TextBox" x:Key="HotkeyBox">
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- Small neutral button (Reset / browse) -->
        <Style TargetType="Button" x:Key="MiniBtn">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,16,20,0">
            <StackPanel>

                <!-- Appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                            <RadioButton x:Name="RbThemeLight" Content="Light" GroupName="theme" Tag="Light"
                                         Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Margin="0,0,18,0"
                                         Checked="Theme_Checked" />
                            <RadioButton x:Name="RbThemeDark" Content="Dark" GroupName="theme" Tag="Dark"
                                         Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Margin="0,0,18,0"
                                         Checked="Theme_Checked" />
                            <RadioButton x:Name="RbThemeSystem" Content="System" GroupName="theme" Tag="System"
                                         Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                                         Checked="Theme_Checked" />
                        </StackPanel>

                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Accent gradient" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Button x:Name="BtnAccentStart" Grid.Column="1" Width="40" Height="28" Cursor="Hand"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Click="AccentStart_Click"
                                    ToolTip="Gradient start colour" />
                            <TextBlock Grid.Column="2" Text="&#x2192;" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="8,0" />
                            <Button x:Name="BtnAccentEnd" Grid.Column="3" Width="40" Height="28" Cursor="Hand"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Click="AccentEnd_Click"
                                    ToolTip="Gradient end colour" />
                            <Button Grid.Column="5" Content="&#x21BA; Reset" Style="{StaticResource MiniBtn}"
                                    Padding="10,0" Height="26" FontSize="11" Click="ResetAccent_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gradient angle" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Slider x:Name="SldAngle" Grid.Column="1" Minimum="0" Maximum="360" Value="135"
                                    VerticalAlignment="Center" ValueChanged="Angle_Changed" />
                            <TextBlock x:Name="TxtAngle" Grid.Column="2" Text="135&#xB0;" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13" Margin="8,0,0,0" Width="40" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Presets" Style="{StaticResource Label}" Margin="0,2,0,4" />
                        <WrapPanel x:Name="PanelAccentPresets" Margin="0,0,0,8" />

                        <CheckBox x:Name="ChkTint" Content="Tint window &amp; header with accent" Click="Tint_Changed" />
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" />
                        <CheckBox x:Name="ChkRecordCursor" Content="Show mouse cursor in recordings" />
                        <CheckBox x:Name="ChkHighlightCursor" Content="Highlight cursor with a yellow circle" Margin="20,2,0,0" />
                        <CheckBox x:Name="ChkShowNotifications" Content="Show notifications" />
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to system tray" />
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <TextBlock Text="Hotkeys" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Click a field, then press your desired key combination" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Capture region" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtCaptureHotkey" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" />
                            <Button Grid.Column="2" Content="Reset" Width="50" Height="26" Margin="6,0,0,0"
                                    Click="ResetHotkey_Click" Tag="CaptureHotkey" FontSize="11"
                                    Style="{StaticResource MiniBtn}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fullscreen save" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtFullscreenSaveHotkey" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" />
                            <Button Grid.Column="2" Content="Reset" Width="50" Height="26" Margin="6,0,0,0"
                                    Click="ResetHotkey_Click" Tag="FullscreenSaveHotkey" FontSize="11"
                                    Style="{StaticResource MiniBtn}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fullscreen copy" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtFullscreenClipHotkey" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" />
                            <Button Grid.Column="2" Content="Reset" Width="50" Height="26" Margin="6,0,0,0"
                                    Click="ResetHotkey_Click" Tag="FullscreenClipHotkey" FontSize="11"
                                    Style="{StaticResource MiniBtn}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="History" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtHistoryHotkey" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" />
                            <Button Grid.Column="2" Content="Reset" Width="50" Height="26" Margin="6,0,0,0"
                                    Click="ResetHotkey_Click" Tag="HistoryHotkey" FontSize="11"
                                    Style="{StaticResource MiniBtn}" />
                        </Grid>
                        <!-- Duplicate warning -->
                        <TextBlock x:Name="TxtHotkeyWarning" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Annotation & Recording Shortcuts -->
                <TextBlock Text="Annotation &amp; Recording Shortcuts" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Shared across screenshot and recording — click a field, then press your desired key" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="ToolShortcutsPanel" />
                </Border>

                <!-- Toolbar Shortcuts -->
                <TextBlock Text="Toolbar Shortcuts" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Active on the snipping toolbar before region selection" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="ToolbarShortcutsPanel" />
                </Border>

                <!-- Save Settings -->
                <TextBlock Text="Output" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default format" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <ComboBox x:Name="CmbFormat" Grid.Column="1" Height="28">
                                <ComboBoxItem Content="PNG" />
                                <ComboBoxItem Content="JPG" />
                                <ComboBoxItem Content="BMP" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JPEG quality" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Slider x:Name="SldJpegQuality" Grid.Column="1" Minimum="10" Maximum="100"
                                    Value="90" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtJpegQuality" Grid.Column="2" Text="90" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13" Margin="8,0,0,0" Width="24" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Save directory" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtSaveDir" Grid.Column="1" Height="28" Padding="6,4"
                                     Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" FontSize="11" />
                            <Button Grid.Column="2" Content="..." Width="32" Height="28" Margin="6,0,0,0"
                                    Click="BrowseDir_Click" Style="{StaticResource MiniBtn}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recording -->
                <TextBlock Text="Recording" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ChkRecordAudio" Content="Enable audio recording (microphone)" />
                        <TextBlock Text="When enabled, microphone audio is captured with video. Can also be toggled during recording."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="20,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- History -->
                <TextBlock Text="History" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ChkSaveHistory" Content="Save screenshot history" />
                        <Grid Margin="0,6,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="History folder" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtHistoryDir" Grid.Column="1" Height="28" Padding="6,4"
                                     Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" FontSize="11" />
                            <Button Grid.Column="2" Content="..." Width="32" Height="28" Margin="6,0,0,0"
                                    Click="BrowseHistoryDir_Click" Style="{StaticResource MiniBtn}" />
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max items" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtMaxHistory" Grid.Column="1" Height="28" Padding="6,4"
                                     Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Preview -->
                <TextBlock Text="Quick Preview" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ChkQuickPreview" Content="Enable Quick Preview (Space in Explorer)" />
                        <TextBlock Text="Press Spacebar in File Explorer to preview files. Supports images, video, audio, text, PDF, and more."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="20,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <Border Grid.Row="1" Background="{DynamicResource HeaderGradientBrush}" Padding="20,12" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="90" Height="32" Click="Save_Click"
                        Background="{DynamicResource AccentGradientBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                <Button Content="Cancel" Width="90" Height="32" Margin="10,0,0,0" Click="Cancel_Click"
                        Style="{StaticResource MiniBtn}" FontSize="13" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
