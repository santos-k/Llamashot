<Window x:Class="Llamashot.Views.OcrToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="OCR — Extract Text"
        Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowGradientBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Cap">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" x:Key="Tool">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Accent" BasedOn="{StaticResource Tool}">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox" x:Key="Combo">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style x:Key="IconStroke" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="IconFill" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <PathGeometry x:Key="IcOpen" Figures="M1.5,4.5 L6,4.5 L7.5,6 L14.5,6 L14.5,13 L1.5,13 Z" />
        <PathGeometry x:Key="IcDown" Figures="M8,2 L8,10 M4.5,6.8 L8,10.5 L11.5,6.8 M3,14 L13,14" />
        <PathGeometry x:Key="IcPdf" Figures="M3,1.5 L10,1.5 L13,4.5 L13,14.5 L3,14.5 Z M10,1.5 L10,4.5 L13,4.5" />
        <PathGeometry x:Key="IcCopy" Figures="M5,5 L5,2 L13,2 L13,11 L10,11 M3,5 L11,5 L11,14 L3,14 Z" />
        <PathGeometry x:Key="IcRun" Figures="M4,2.5 L13,8 L4,13.5 Z" />
        <PathGeometry x:Key="IcClose" Figures="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource HeaderGradientBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OCR — Extract Text" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />

                <Button x:Name="BtnOpen" Style="{StaticResource Tool}" Margin="0,8,12,0" Click="Open_Click"
                        ToolTip="Open an image or PDF  (O)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" /><TextBlock Text="Open" VerticalAlignment="Center" /></StackPanel>
                </Button>

                <TextBlock Text="Engine" Style="{StaticResource Cap}" Margin="0,8,6,0" />
                <ComboBox x:Name="CboEngine" Style="{StaticResource Combo}" Width="180" Margin="0,8,14,0"
                          SelectionChanged="Engine_Changed" DisplayMemberPath="Name" SelectedValuePath="Id" />

                <TextBlock Text="Language" Style="{StaticResource Cap}" Margin="0,8,6,0" />
                <ComboBox x:Name="CboLang" Style="{StaticResource Combo}" Width="180" Margin="0,8,14,0"
                          DisplayMemberPath="Display" SelectedValuePath="Code" />

                <CheckBox x:Name="ChkPdf" Content="Create searchable PDF" Margin="0,8,16,0" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="True"
                          ToolTip="Also save a PDF that looks identical but has selectable, searchable text" />

                <Button x:Name="BtnRun" Style="{StaticResource Accent}" Margin="0,8,8,0" Click="Run_Click"
                        ToolTip="Run OCR on the open file  (Enter)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcRun}" /><TextBlock Text="Run OCR" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Body: source preview | results -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Source preview -->
            <Border Grid.Column="0" Background="#11000000" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Padding="14">
                        <Image x:Name="Img" Stretch="Uniform" StretchDirection="DownOnly" />
                    </ScrollViewer>
                    <TextBlock x:Name="TxtSrcInfo" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,0,10"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSoftBrush}" />

            <!-- Results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,0,1" Padding="14,9">
                    <DockPanel>
                        <TextBlock x:Name="TxtResultInfo" Text="Extracted text" DockPanel.Dock="Left"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCopy" Style="{StaticResource Tool}" Margin="0,0,6,0" Click="Copy_Click" IsEnabled="False" ToolTip="Copy all text">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcCopy}" /><TextBlock Text="Copy" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="BtnSaveTxt" Style="{StaticResource Tool}" Margin="0,0,6,0" Click="SaveTxt_Click" IsEnabled="False" ToolTip="Save as .txt">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcDown}" /><TextBlock Text="Save .txt" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="BtnSavePdf" Style="{StaticResource Accent}" Click="SavePdf_Click" IsEnabled="False" ToolTip="Save a searchable PDF">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcPdf}" /><TextBlock Text="Searchable PDF" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBox x:Name="TxtResult" Grid.Row="1" Margin="0" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                         FontFamily="Consolas, Segoe UI" FontSize="13" Padding="14"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="1" x:Name="TxtResultHint" Margin="14" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap"
                           Text="Open an image or PDF, then press Run OCR. The most accurate engine (Tesseract) is selected by default." />

                <Border Grid.Row="2" x:Name="StatusBar" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="14,7"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                </Border>
            </Grid>
        </Grid>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" Stretch="Uniform" Width="56" Height="56"
                  Fill="{DynamicResource TextMutedBrush}" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,18" />
            <TextBlock Text="Open an image or PDF to extract its text"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,18" />
            <Button Style="{StaticResource Accent}" Click="Open_Click" HorizontalAlignment="Center" Padding="22,11" FontSize="14">
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" /><TextBlock Text="Open File" VerticalAlignment="Center" /></StackPanel>
            </Button>
        </StackPanel>

        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <TextBlock x:Name="TxtBusy" Text="Running OCR…" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <ProgressBar x:Name="PrgBusy" Height="6" Minimum="0" Maximum="100" />
                <Button x:Name="BtnCancel" Style="{StaticResource Tool}" Click="Cancel_Click" Margin="0,14,0,0"
                        HorizontalAlignment="Center" Padding="18,7">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcClose}" /><TextBlock Text="Cancel" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
