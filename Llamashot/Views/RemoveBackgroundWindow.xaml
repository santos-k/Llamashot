<Window x:Class="Llamashot.Views.RemoveBackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="Remove Background"
        Width="1100" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowGradientBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Cap">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Button" x:Key="Tool">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Accent" BasedOn="{StaticResource Tool}">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Vector tool icons (no emoji-font dependency) -->
        <Style x:Key="IconFill" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="IconStroke" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <PathGeometry x:Key="IcOpen" Figures="M1.5,4.5 L6,4.5 L7.5,6 L14.5,6 L14.5,13 L1.5,13 Z" />
        <PathGeometry x:Key="IcAuto" Figures="M8,1 L9.2,6.8 L15,8 L9.2,9.2 L8,15 L6.8,9.2 L1,8 L6.8,6.8 Z" />
        <PathGeometry x:Key="IcWand" Figures="M11.5,1 L12.4,3.1 L14.5,4 L12.4,4.9 L11.5,7 L10.6,4.9 L8.5,4 L10.6,3.1 Z M9,6.6 L10.4,8 L3.4,15 L2,13.6 Z" />
        <PathGeometry x:Key="IcErase" Figures="M6.8,14.5 L2,9.7 C1.5,9.2 1.5,8.4 2,7.9 L8.2,1.7 C8.7,1.2 9.5,1.2 10,1.7 L14.3,6 C14.8,6.5 14.8,7.3 14.3,7.8 L9.6,12.5 L14.5,12.5 L14.5,14.5 Z" />
        <PathGeometry x:Key="IcRestore" Figures="M12.6,6.2 A5,5 0 1 0 13,10.4 M12.6,6.2 L9.9,5.7 M12.6,6.2 L12.1,8.9" />
        <PathGeometry x:Key="IcBlur" Figures="M2,5.5 Q5,3 8,5.5 T14,5.5 M2,9 Q5,6.5 8,9 T14,9 M2,12.5 Q5,10 8,12.5 T14,12.5" />
        <PathGeometry x:Key="IcUndo" Figures="M5.5,5 L2.5,8 L5.5,11 M2.5,8 L10.5,8 A3.5,3.5 0 0 1 10.5,15 L8.5,15" />
        <PathGeometry x:Key="IcRedo" Figures="M10.5,5 L13.5,8 L10.5,11 M13.5,8 L5.5,8 A3.5,3.5 0 0 0 5.5,15 L7.5,15" />
        <PathGeometry x:Key="IcDown" Figures="M8,2 L8,10 M4.5,6.8 L8,10.5 L11.5,6.8 M3,14 L13,14" />
        <PathGeometry x:Key="IcAi" Figures="M6,1 L6.9,3.4 9.3,4.3 6.9,5.2 6,7.6 5.1,5.2 2.7,4.3 5.1,3.4 Z M11.5,7.5 L12.2,9.3 14,10 12.2,10.7 11.5,12.5 10.8,10.7 9,10 10.8,9.3 Z" />
        <PathGeometry x:Key="IcPan" Figures="M8,1 L10.4,3.4 L8.8,3.4 L8.8,7.2 L12.6,7.2 L12.6,5.6 L15,8 L12.6,10.4 L12.6,8.8 L8.8,8.8 L8.8,12.6 L10.4,12.6 L8,15 L5.6,12.6 L7.2,12.6 L7.2,8.8 L3.4,8.8 L3.4,10.4 L1,8 L3.4,5.6 L3.4,7.2 L7.2,7.2 L7.2,3.4 L5.6,3.4 Z" />
        <PathGeometry x:Key="IcClose" Figures="M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5" />

        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,22,22" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D9DDE3">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,11,11" />
                                <RectangleGeometry Rect="11,11,11,11" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource HeaderGradientBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Remove Background" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />

                <Button x:Name="BtnOpen" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="Open_Click"
                        ToolTip="Open an image  (O)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" /><TextBlock Text="Open" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource Tool}" Margin="0,16,12,0" Click="CloseFile_Click" ToolTip="Close the current image  (Esc)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcClose}" /><TextBlock Text="Close" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnAuto" Style="{StaticResource Tool}" Margin="0,16,8,0" Click="Auto_Click"
                        ToolTip="Fast colour-based removal — best for solid / near-solid backgrounds  (A)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcAuto}" /><TextBlock Text="Auto Remove" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnAi" Style="{StaticResource Accent}" Margin="0,16,12,0" Click="AiRemove_Click"
                        ToolTip="AI removal — works on any photo incl. complex backgrounds (downloads a model on first use)  (I)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcAi}" /><TextBlock Text="AI Remove" VerticalAlignment="Center" /></StackPanel>
                </Button>

                <StackPanel Margin="0,0,14,0" Width="150">
                    <TextBlock x:Name="TxtTol" Text="TOLERANCE — 30" Style="{StaticResource Cap}" />
                    <Slider x:Name="SldTol" Minimum="2" Maximum="100" Value="30" Height="28" VerticalAlignment="Center"
                            ValueChanged="Tol_Changed" />
                </StackPanel>

                <Border Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,18,12,0" Height="30" />

                <Button x:Name="BtnWand" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="Tool_Click" Tag="Wand"
                        ToolTip="Magic wand — click a colour to remove it  (W)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcWand}" /><TextBlock Text="Wand" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnErase" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="Tool_Click" Tag="Erase"
                        ToolTip="Erase brush — paint away the background  (E)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcErase}" /><TextBlock Text="Erase" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnRestore" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="Tool_Click" Tag="Restore"
                        ToolTip="Restore brush — paint back removed areas  (R)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcRestore}" /><TextBlock Text="Restore" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnBlur" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="Tool_Click" Tag="Blur"
                        ToolTip="Blur brush — soften an area  (B)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcBlur}" /><TextBlock Text="Blur" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnPan" Style="{StaticResource Tool}" Margin="0,16,12,0" Click="Tool_Click" Tag="Pan"
                        ToolTip="Pan the image when zoomed in — drag (or middle / right mouse anytime)  (H / Space)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcPan}" /><TextBlock Text="Pan" VerticalAlignment="Center" /></StackPanel>
                </Button>

                <StackPanel Margin="0,0,12,0" Width="140">
                    <TextBlock x:Name="TxtBrush" Text="BRUSH — 40 px" Style="{StaticResource Cap}" />
                    <Slider x:Name="SldBrush" Minimum="6" Maximum="220" Value="40" Height="28" VerticalAlignment="Center"
                            ValueChanged="Brush_Changed" ToolTip="Brush size — [ smaller · ] bigger" />
                </StackPanel>

                <StackPanel Margin="0,0,14,0" Width="120">
                    <TextBlock x:Name="TxtEdge" Text="EDGE — 2 px" Style="{StaticResource Cap}" />
                    <Slider x:Name="SldEdge" Minimum="0" Maximum="8" Value="2" Height="28" VerticalAlignment="Center"
                            ValueChanged="Edge_Changed" ToolTip="Edge smoothing applied after Auto / AI / Wand removal" />
                </StackPanel>

                <Border Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,18,12,0" Height="30" />

                <Button x:Name="BtnUndo" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="Undo_Click" ToolTip="Undo  (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcUndo}" /><TextBlock Text="Undo" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnRedo" Style="{StaticResource Tool}" Margin="0,16,12,0" Click="Redo_Click" ToolTip="Redo  (Ctrl+Y)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcRedo}" /><TextBlock Text="Redo" VerticalAlignment="Center" /></StackPanel>
                </Button>

                <Button x:Name="BtnExportPng" Style="{StaticResource Accent}" Margin="0,16,8,0" Click="ExportPng_Click" ToolTip="Export transparent PNG  (Ctrl+S)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcDown}" /><TextBlock Text="PNG" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnExportJpg" Style="{StaticResource Tool}" Margin="0,16,6,0" Click="ExportJpg_Click" ToolTip="Export flattened JPG  (Ctrl+Shift+S)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStroke}" Data="{StaticResource IcDown}" /><TextBlock Text="JPG" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="BtnBgColor" Width="30" Height="30" Margin="0,16,0,0" Cursor="Hand"
                        Background="White" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Click="BgColor_Click" ToolTip="JPG background colour" />
            </WrapPanel>
        </Border>

        <!-- Canvas -->
        <Grid Grid.Row="1" x:Name="CenterHost" Background="{DynamicResource WindowBrush}"
              ClipToBounds="True" SizeChanged="CenterHost_SizeChanged" MouseWheel="Canvas_Wheel">
            <Canvas x:Name="PanCanvas" Background="Transparent"
                    MouseDown="Pan_Down" MouseMove="Pan_Move" MouseUp="Pan_Up">
                <Border x:Name="ImgHost" Background="{StaticResource Checker}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.4" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <!-- Ghost of the removed area, shown faintly while the Restore tool is active. -->
                        <Image x:Name="GhostImg" Opacity="0.2" Visibility="Collapsed" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Image x:Name="Img" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="Img_Down" MouseMove="Img_Move" MouseLeftButtonUp="Img_Up" MouseLeave="Img_Leave" />
                    </Grid>
                </Border>
            </Canvas>

            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Ellipse x:Name="BrushRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                         Visibility="Collapsed" IsHitTestVisible="False" />
            </Canvas>

            <!-- Zoom controls -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6,4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Content="&#x2212;" Style="{StaticResource Tool}" Width="34" Padding="0,4" Click="ZoomOut_Click" />
                    <TextBlock x:Name="TxtZoom" Text="100%" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12.5" Width="56" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="&#x2b;" Style="{StaticResource Tool}" Width="34" Padding="0,4" Click="ZoomIn_Click" Margin="0,0,6,0" />
                    <Button Content="Fit" Style="{StaticResource Tool}" Padding="10,4" Click="Fit_Click" Margin="0,0,6,0" />
                    <Button Content="1:1" Style="{StaticResource Tool}" Padding="10,4" Click="OneToOne_Click" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtHint" Text="Open an image to begin." Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <!-- Initial empty state: a big centered Open button -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" Stretch="Uniform" Width="56" Height="56"
                      Fill="{DynamicResource TextMutedBrush}" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock Text="Open an image to remove its background"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <Button Style="{StaticResource Accent}" Click="Open_Click" HorizontalAlignment="Center" Padding="22,11" FontSize="14">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconFill}" Data="{StaticResource IcOpen}" /><TextBlock Text="Open Image" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </StackPanel>

            <!-- Busy / download overlay -->
            <Border x:Name="BusyOverlay" Background="#99000000" Visibility="Collapsed">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,22" Width="340"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TxtBusy" Text="Working…" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <ProgressBar x:Name="PrgBusy" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}"
                                     BorderThickness="0" IsIndeterminate="True" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
