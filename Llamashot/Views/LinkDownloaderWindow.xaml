<Window x:Class="Llamashot.Views.LinkDownloaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/icon32.png"
        Title="Link Downloader"
        Width="720" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowGradientBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Cap">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Button" x:Key="Tool">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Accent" BasedOn="{StaticResource Tool}">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🔗" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Link Downloader" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- URL input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="PASTE LINK(S) — one per line" Style="{StaticResource Cap}" />
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="TxtUrls" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="10,8"
                         FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                         TextChanged="Urls_Changed" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnPaste" Style="{StaticResource Tool}" Content="📋  Paste" Click="Paste_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnClear" Style="{StaticResource Tool}" Content="Clear" Click="Clear_Click" />
                <TextBlock x:Name="TxtKind" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="ChkAudio" Content="Audio only (MP3) — for video/media links"
                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" Cursor="Hand" />
        </StackPanel>

        <!-- Output folder -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="SAVE TO" Style="{StaticResource Cap}" />
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="10,7" Width="480">
                    <TextBlock x:Name="TxtOutDir" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Border>
                <Button x:Name="BtnChangeDir" Style="{StaticResource Tool}" Content="Change…" Click="ChangeDir_Click" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Action + progress -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnDownload" Style="{StaticResource Accent}" Content="⬇  Download" Padding="22,10"
                        FontSize="14" Click="Download_Click" />
                <Button x:Name="BtnCancel" Style="{StaticResource Tool}" Content="Cancel" Padding="18,10" FontSize="14"
                        Click="Cancel_Click" Margin="8,0,0,0" Visibility="Collapsed" />
            </StackPanel>
            <ProgressBar x:Name="Prg" Height="8" Margin="0,12,0,0" Minimum="0" Maximum="100"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}"
                         BorderThickness="0" Visibility="Collapsed" />
            <TextBlock x:Name="TxtStatus" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Completed list -->
        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DOWNLOADS" Style="{StaticResource Cap}" Margin="12,10,12,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0,6,8">
                    <StackPanel x:Name="DoneList" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
