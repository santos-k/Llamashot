<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F5F6FB"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EEF1F8"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDF0FA"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E2E6F0"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6172"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA0B0"/>

    <!-- Accent (teal default; overridden at runtime by ThemeManager.ApplyAccent) -->
    <Color x:Key="AccentColor">#0FB5A8</Color>
    <Color x:Key="Accent2Color">#10B981</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#0FB5A8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0.15,0.15" EndPoint="0.85,0.85">
        <GradientStop Color="#0FB5A8" Offset="0"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="#22A081"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#CCF5F6FB"/>

    <!-- Surface gradients (neutral; ApplyAccent re-tints these when WindowTint is on) -->
    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F5F6FB" Offset="0.7"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0.5">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F4F6FF" Offset="0.8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F7F9FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Specular glare colour used by the 3D hover (Core/TiltBehavior) -->
    <Color x:Key="GlareColor">#A8FFFFFF</Color>
</ResourceDictionary>
