<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#14151A"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#1B1C24"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2029"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262833"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2A2D38"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#313443"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAF0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8AEC0"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7080"/>

    <!-- Accent (teal default; overridden at runtime by ThemeManager.ApplyAccent) -->
    <Color x:Key="AccentColor">#2DD4BF</Color>
    <Color x:Key="Accent2Color">#34D399</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#06201C"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0.15,0.15" EndPoint="0.85,0.85">
        <GradientStop Color="#2DD4BF" Offset="0"/>
        <GradientStop Color="#34D399" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="#5BD0A4"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A7A"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC14151A"/>

    <!-- Surface gradients (neutral; ApplyAccent re-tints these when WindowTint is on) -->
    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#16171C" Offset="0"/>
        <GradientStop Color="#131419" Offset="0.7"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0.5">
        <GradientStop Color="#1E1F28" Offset="0"/>
        <GradientStop Color="#1B1C24" Offset="0.8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#212430" Offset="0"/>
        <GradientStop Color="#1E2029" Offset="1"/>
    </LinearGradientBrush>

    <!-- Specular glare colour used by the 3D hover (Core/TiltBehavior) -->
    <Color x:Key="GlareColor">#26FFFFFF</Color>
</ResourceDictionary>
