<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Llamashot</AssemblyName>
    <RootNamespace>Llamashot</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>8.9.28</Version>
    <AssemblyVersion>8.9.28</AssemblyVersion>
    <FileVersion>8.9.28</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" NoWarn="NU1510" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**" />
  </ItemGroup>

  <!-- Tesseract language data ships loose next to the exe (kept out of the single-file bundle)
       so the OCR engine can locate tessdata\ at runtime. -->
  <ItemGroup>
    <None Include="tessdata\**\*">
      <Link>tessdata\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!-- The Tesseract package adds its native libs as None items linked into x64\ / x86\. Keep the
       64-bit pair loose on disk (the native loader needs x64\*.dll next to the exe under
       single-file publish) and drop the unused 32-bit pair. -->
  <Target Name="ConfigureTesseractNatives" BeforeTargets="AssignTargetPaths;ComputeFilesToPublish">
    <ItemGroup>
      <None Update="@(None)"
            Condition="'%(None.Link)' == 'x64\tesseract50.dll' or '%(None.Link)' == 'x64\leptonica-1.82.0.dll'">
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </None>
      <None Remove="@(None)"
            Condition="'%(None.Link)' == 'x86\tesseract50.dll' or '%(None.Link)' == 'x86\leptonica-1.82.0.dll'" />
    </ItemGroup>
  </Target>

</Project>
